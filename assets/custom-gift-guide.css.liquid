/* ==========================================================
   GIFT GUIDE — isolated styles
   All rules use .cgg prefix + !important where base.css wins
   ========================================================== */

/* ── 1. PAGE-LEVEL FIXES (scoped to gift-guide template) ── */

/* base.css locks html/body to 100dvh + overflow:hidden on desktop.
   This breaks our full-height hero. Undo it. */
body[data-template="page.gift-guide"],
body[data-template="page.gift-guide"] html {
  height: auto !important;
  overflow: visible !important;
  overflow-x: hidden !important;
}

/* Hide the Shopify theme header + footer — our section has its own header */
body[data-template="page.gift-guide"] #header-group {
  display: none !important;
}

body[data-template="page.gift-guide"] footer {
  display: none !important;
}

/* Remove any top padding/margin the theme injects into main */
body[data-template="page.gift-guide"] #MainContent,
body[data-template="page.gift-guide"] .content-for-layout {
  padding: 0 !important;
  margin: 0 !important;
  flex: none !important;
  display: block !important;
}

/* Remove shopify-section wrapper spacing */
body[data-template="page.gift-guide"] .shopify-section {
  margin: 0 !important;
  padding: 0 !important;
}

/* ── 2. COMPONENT RESET (scoped to .cgg) ── */

.cgg,
.cgg *,
.cgg *::before,
.cgg *::after {
  box-sizing: border-box !important;
}

.cgg {
  all: initial;
  display: block;
  font-family: 'Poppins', sans-serif;
  color: #000;
  width: 100%;
}

/* ── 3. HEADER ── */

.cgg__header {
  display: grid !important;
  grid-template-columns: auto 1fr auto !important;
  align-items: center !important;
  width: 100% !important;
  height: 72px !important;
  background: #f2f2f2 !important;
  padding: 0 56px !important;
  gap: 16px !important;
  position: relative !important;
  z-index: 100 !important;
  margin: 0 !important;
  box-sizing: border-box !important;
}

.cgg__header-logo {
  font-family: 'Poppins', sans-serif !important;
  font-size: 13px !important;
  font-weight: 700 !important;
  letter-spacing: 0.28em !important;
  text-transform: uppercase !important;
  white-space: nowrap !important;
  color: #000 !important;
  margin: 0 !important;
  padding: 0 !important;
  line-height: 1 !important;
}

.cgg__header-tagline {
  font-family: 'Poppins', sans-serif !important;
  font-size: 14px !important;
  font-weight: 400 !important;
  text-align: center !important;
  color: #000 !important;
  margin: 0 !important;
  padding: 0 !important;
  line-height: 1.4 !important;
}

.cgg__header-cta {
  /* Reset all inherited/theme button styles */
  all: unset !important;
  box-sizing: border-box !important;
  display: inline-flex !important;
  align-items: center !important;
  justify-content: center !important;
  width: 220px !important;
  height: 52px !important;
  background: #ece21c !important;
  color: #000 !important;
  font-family: 'Poppins', sans-serif !important;
  font-size: 12px !important;
  font-weight: 700 !important;
  letter-spacing: 0.14em !important;
  text-transform: uppercase !important;
  text-decoration: none !important;
  white-space: nowrap !important;
  cursor: pointer !important;
  border-radius: 0 !important;
  border: none !important;
  flex-shrink: 0 !important;
}

.cgg__header-cta:hover {
  background: #d9cf00 !important;
  color: #000 !important;
}

/* ── 4. HERO ── */

.cgg__hero {
  position: relative !important;
  display: block !important;
  width: 100% !important;
  height: calc(100vh - 72px) !important;
  min-height: 600px !important;
  overflow: hidden !important;
  background: #e8e8e8 !important;
  margin: 0 !important;
  padding: 0 !important;
}

/* ── 5. BACKGROUND IMAGE ── */

.cgg__hero-bg {
  position: absolute !important;
  top: 0 !important;
  left: 0 !important;
  right: 0 !important;
  /* stop at the strip */
  bottom: 42px !important;
  z-index: 0 !important;
  overflow: hidden !important;
}

/* Override base.css: img { width:100%; height:auto } */
.cgg__hero-bg-img {
  display: block !important;
  width: 100% !important;
  height: 100% !important;
  max-width: none !important;
  object-fit: cover !important;
  object-position: center top !important;
}

/* ── 6. OVERLAY CARD ── */

.cgg__card {
  position: absolute !important;
  left: 56px !important;
  bottom: 74px !important;
  z-index: 10 !important;
  width: 540px !important;
  min-height: 520px !important;
  background-color: #efefef !important;
  border-radius: 40px !important;
  padding: 50px !important;
  box-shadow: 0 25px 60px rgba(0, 0, 0, 0.12) !important;
  display: flex !important;
  flex-direction: column !important;
  gap: 24px !important;
  justify-content: center !important;
  margin: 0 !important;
  color: #000 !important;
  /* Prevent base.css section grid from collapsing this */
  grid-column: unset !important;
}

/* Override base.css h1 font/size/weight */
.cgg__card-title {
  all: unset !important;
  display: block !important;
  font-family: 'Playfair Display', serif !important;
  font-size: 96px !important;
  font-weight: 900 !important;
  line-height: 0.9 !important;
  color: #000 !important;
  letter-spacing: -0.02em !important;
  margin: 0 !important;
  padding: 0 !important;
  overflow-wrap: break-word !important;
}

/* Override base.css p margin */
.cgg__card-desc {
  all: unset !important;
  display: block !important;
  font-family: 'Poppins', sans-serif !important;
  font-size: 22px !important;
  line-height: 1.8 !important;
  color: #000 !important;
  max-width: 430px !important;
  white-space: pre-line !important;
  margin: 0 !important;
  padding: 0 !important;
}

/* Override base.css .button completely */
.cgg__card-cta {
  all: unset !important;
  box-sizing: border-box !important;
  display: inline-flex !important;
  align-items: center !important;
  justify-content: center !important;
  width: 280px !important;
  height: 74px !important;
  background-color: #000 !important;
  color: #fff !important;
  border-radius: 999px !important;
  text-decoration: none !important;
  font-family: 'Poppins', sans-serif !important;
  font-size: 12px !important;
  font-weight: 800 !important;
  letter-spacing: 0.25em !important;
  text-transform: uppercase !important;
  cursor: pointer !important;
  flex-shrink: 0 !important;
  border: none !important;
  padding: 0 !important;
}

.cgg__card-cta:hover {
  background-color: #222 !important;
  color: #fff !important;
}

/* ── 7. BOTTOM STRIP ── */

.cgg__strip {
  position: absolute !important;
  left: 0 !important;
  right: 0 !important;
  bottom: 0 !important;
  height: 42px !important;
  background: #e8e8e8 !important;
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  z-index: 20 !important;
  margin: 0 !important;
  padding: 0 16px !important;
}

.cgg__strip-text {
  font-family: 'Poppins', sans-serif !important;
  font-size: 14px !important;
  font-weight: 600 !important;
  letter-spacing: 0.14em !important;
  text-transform: uppercase !important;
  color: #000 !important;
  text-align: center !important;
  margin: 0 !important;
  padding: 0 !important;
  line-height: 1 !important;
}

/* ── 8. TABLET (≤1024px) ── */

@media (max-width: 1024px) {
  .cgg__header {
    padding: 0 32px !important;
  }

  .cgg__card {
    left: 32px !important;
    width: min(480px, calc(100% - 64px)) !important;
    min-height: auto !important;
    padding: 40px !important;
  }

  .cgg__card-title {
    font-size: clamp(56px, 8vw, 96px) !important;
  }

  .cgg__card-desc {
    font-size: 18px !important;
  }
}

/* ── 9. MOBILE (≤680px) ── */

@media (max-width: 680px) {
  .cgg__header {
    grid-template-columns: 1fr !important;
    height: auto !important;
    padding: 16px 20px !important;
    gap: 10px !important;
    text-align: center !important;
    justify-items: center !important;
  }

  .cgg__hero {
    height: auto !important;
    min-height: 100svh !important;
    padding-bottom: 42px !important;
  }

  .cgg__hero-bg {
    position: absolute !important;
    top: 0 !important;
    left: 0 !important;
    right: 0 !important;
    bottom: 42px !important;
    height: auto !important;
  }

  .cgg__card {
    position: relative !important;
    left: auto !important;
    bottom: auto !important;
    width: calc(100% - 32px) !important;
    margin: 24px auto 0 !important;
    min-height: auto !important;
    padding: 32px 28px !important;
    border-radius: 28px !important;
  }

  .cgg__card-title {
    font-size: clamp(44px, 12vw, 72px) !important;
  }

  .cgg__card-desc {
    font-size: 16px !important;
    max-width: 100% !important;
  }

  .cgg__card-cta {
    width: 100% !important;
    height: 64px !important;
  }

  .cgg__strip {
    position: relative !important;
    margin-top: 0 !important;
  }
}
