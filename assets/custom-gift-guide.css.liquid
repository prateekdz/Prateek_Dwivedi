/* ============================================================
   custom-gift-guide — fully isolated, zero theme dependencies
   BEM: .cgg__*
   ============================================================ */

/* ── Reset scope ── */
.cgg,
.cgg *,
.cgg *::before,
.cgg *::after {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

.cgg {
  font-family: 'Poppins', sans-serif;
  color: #000;
  width: 100%;
}

/* ── HEADER ── */
.cgg__header {
  width: 100%;
  height: 72px;
  background: #f2f2f2;
  display: grid;
  grid-template-columns: auto 1fr auto;
  align-items: center;
  gap: 16px;
  padding: 0 56px;
  position: relative;
  z-index: 10;
}

.cgg__header-logo {
  font-size: 0.9rem;
  font-weight: 700;
  letter-spacing: 0.28em;
  text-transform: uppercase;
  white-space: nowrap;
}

.cgg__header-tagline {
  font-size: 0.9rem;
  font-weight: 400;
  text-align: center;
  letter-spacing: 0.02em;
  line-height: 1.4;
}

.cgg__header-cta {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 220px;
  height: 52px;
  background: #ece21c;
  color: #000;
  text-decoration: none;
  font-size: 0.82rem;
  font-weight: 700;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  white-space: nowrap;
  flex-shrink: 0;
}

.cgg__header-cta:hover {
  background: #d9cf00;
}

/* ── HERO ── */
.cgg__hero {
  position: relative;
  width: 100%;
  height: calc(100vh - 72px);
  min-height: 600px;
  overflow: hidden;
}

/* Full-bleed background */
.cgg__hero-bg {
  position: absolute;
  inset: 0;
  z-index: 0;
}

.cgg__hero-bg-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center top;
  display: block;
}

/* ── OVERLAY CARD ── */
.cgg__card {
  position: absolute;
  left: 56px;
  bottom: 56px;
  z-index: 5;
  width: 540px;
  min-height: 520px;
  background: #efefef;
  border-radius: 40px;
  padding: 50px;
  box-shadow: 0 25px 60px rgba(0, 0, 0, 0.12);
  display: flex;
  flex-direction: column;
  gap: 24px;
  justify-content: center;
}

.cgg__card-title {
  font-family: 'Playfair Display', serif;
  font-size: 96px;
  font-weight: 900;
  line-height: 0.9;
  color: #000;
  letter-spacing: -0.02em;
}

.cgg__card-desc {
  font-size: 22px;
  line-height: 1.8;
  color: #000;
  max-width: 430px;
  white-space: pre-line;
}

.cgg__card-cta {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 280px;
  height: 74px;
  background: #000;
  color: #fff;
  border-radius: 999px;
  text-decoration: none;
  font-size: 0.82rem;
  font-weight: 800;
  letter-spacing: 0.25em;
  text-transform: uppercase;
  flex-shrink: 0;
}

.cgg__card-cta:hover {
  background: #222;
}

/* ── BOTTOM STRIP ── */
.cgg__strip {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 42px;
  background: #e8e8e8;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 6;
}

.cgg__strip-text {
  font-size: 14px;
  font-weight: 600;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: #000;
  text-align: center;
}

/* ── RESPONSIVE — Tablet (≤1024px) ── */
@media (max-width: 1024px) {
  .cgg__header {
    padding: 0 32px;
  }

  .cgg__card {
    left: 32px;
    bottom: 56px;
    width: min(480px, calc(100% - 64px));
    min-height: auto;
    padding: 40px;
  }

  .cgg__card-title {
    font-size: clamp(56px, 8vw, 96px);
  }

  .cgg__card-desc {
    font-size: 18px;
  }
}

/* ── RESPONSIVE — Mobile (≤680px) ── */
@media (max-width: 680px) {
  .cgg__header {
    grid-template-columns: 1fr;
    height: auto;
    padding: 16px 20px;
    gap: 10px;
    text-align: center;
    justify-items: center;
  }

  .cgg__hero {
    height: auto;
    min-height: 100svh;
    padding-bottom: 42px;
  }

  .cgg__card {
    position: relative;
    left: auto;
    bottom: auto;
    width: calc(100% - 32px);
    margin: 24px auto 0;
    min-height: auto;
    padding: 32px 28px;
    border-radius: 28px;
  }

  .cgg__card-title {
    font-size: clamp(44px, 12vw, 72px);
  }

  .cgg__card-desc {
    font-size: 16px;
    max-width: 100%;
  }

  .cgg__card-cta {
    width: 100%;
    height: 64px;
  }

  .cgg__hero-bg {
    position: fixed;
    height: 100svh;
  }

  .cgg__strip {
    position: relative;
    margin-top: 16px;
  }
}
