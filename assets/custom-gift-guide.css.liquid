.cg-hero {
  position: relative;
  width: 100%;
  min-height: 100vh;
  height: 100vh;
  background: #fff url('{{ 'gift-guide-banner.svg' | asset_url }}') center/cover no-repeat;
  background-size: cover;
  overflow: hidden;
}

.cg-hero__frame {
  position: relative;
  width: 100%;
  min-height: 100vh;
  height: 100%;
  padding: 0;
  margin: 0;
}

.cg-hero__header {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  height: 84px;
  display: grid;
  grid-template-columns: auto 1fr auto;
  align-items: center;
  gap: 20px;
  padding: 0 56px;
  background: rgba(255, 255, 255, 0.92);
  backdrop-filter: blur(10px);
  box-shadow: 0 12px 32px rgba(0, 0, 0, 0.08);
  z-index: 20;
}

.cg-hero__brand {
  font-family: 'Poppins', sans-serif;
  font-size: 0.95rem;
  font-weight: 700;
  letter-spacing: 0.3em;
  text-transform: uppercase;
}

.cg-hero__headline-copy {
  font-family: 'Poppins', sans-serif;
  font-size: 1rem;
  font-weight: 500;
  text-align: center;
  letter-spacing: 0.04em;
}

.cg-hero__header-action {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 220px;
  height: 52px;
  padding: 0 24px;
  background: #ece21c;
  color: #111;
  text-decoration: none;
  font-family: 'Poppins', sans-serif;
  font-weight: 700;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  border-radius: 8px;
}

.cg-hero__card {
  position: absolute;
  left: 56px;
  bottom: 56px;
  width: min(640px, calc(100% - 112px));
  background: rgba(255, 255, 255, 0.98);
  border-radius: 48px;
  padding: 56px;
  box-shadow: 0 30px 80px rgba(0, 0, 0, 0.12);
  display: grid;
  gap: 24px;
  z-index: 10;
}

.cg-hero__card-title {
  margin: 0;
  font-family: 'Playfair Display', serif;
  font-size: clamp(3.8rem, 7vw, 5.5rem);
  line-height: 0.92;
  font-weight: 900;
  color: #111;
}

.cg-hero__card-description {
  margin: 0;
  max-width: 500px;
  font-family: 'Poppins', sans-serif;
  font-size: 22px;
  line-height: 1.8;
  color: #111;
}

.cg-hero__card-description--secondary {
  margin-top: 0.75rem;
}

.cg-hero__card-cta {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 280px;
  height: 74px;
  background: #111;
  color: #fff;
  border-radius: 999px;
  text-decoration: none;
  font-family: 'Poppins', sans-serif;
  font-weight: 800;
  letter-spacing: 0.22em;
  text-transform: uppercase;
}

.cg-hero__bottom-strip {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 56px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.94);
  color: #111;
  font-family: 'Poppins', sans-serif;
  font-size: 0.85rem;
  font-weight: 700;
  letter-spacing: 0.24em;
  text-transform: uppercase;
}

#gift-guide-grid {
  scroll-margin-top: 112px;
}

@media (max-width: 980px) {
  .cg-hero__header {
    padding: 0 24px;
    gap: 16px;
    height: auto;
  }

  .cg-hero__headline-copy {
    font-size: 0.95rem;
  }

  .cg-hero__card {
    left: 24px;
    bottom: 24px;
    width: calc(100% - 48px);
    padding: 40px;
  }

  .cg-hero__card-title {
    font-size: clamp(3rem, 8vw, 4.4rem);
  }

  .cg-hero__card-description {
    font-size: 20px;
  }

  .cg-hero__card-cta {
    width: 100%;
  }
}

@media (max-width: 680px) {
  .cg-hero__header {
    grid-template-columns: 1fr;
    justify-items: center;
    text-align: center;
    padding: 16px;
    row-gap: 12px;
  }

  .cg-hero__card {
    left: 50%;
    transform: translateX(-50%);
    width: min(100%, calc(100% - 32px));
    padding: 28px;
    border-radius: 32px;
  }

  .cg-hero__card-title {
    font-size: 3rem;
  }

  .cg-hero__card-description {
    font-size: 18px;
  }

  .cg-hero__card-cta {
    width: 100%;
    height: 64px;
  }
}
