<!doctype html>
<html
  {% if request.design_mode %}
    class="shopify-design-mode"
  {% endif %}
  lang="{{ request.locale.iso_code }}"
>
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="">
    <link rel="canonical" href="{{ canonical_url }}">
    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    {%- render 'meta-tags' -%}

    <link rel="preload" href="{{ 'base.css' | asset_url }}" as="style" onload="this.onload=null;this.rel='stylesheet'" crossorigin>
    <noscript>{{ 'base.css' | asset_url | stylesheet_tag }}</noscript>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@700&family=Playfair+Display:wght@400;500;700;900&family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <script src="{{ 'constants.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'pubsub.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'global.js' | asset_url }}" defer="defer"></script>

    {% if template == 'page.gift-guide' or template == 'index' %}
    <style>
      html:has(body[data-template="page.gift-guide"]),
      html:has(body[data-template="index"]) { height:auto!important; overflow:auto!important; }
      body[data-template="page.gift-guide"],
      body[data-template="index"] { overflow-y:auto!important; height:auto!important; }
      body[data-template="page.gift-guide"] .page-wrapper,
      body[data-template="index"] .page-wrapper { height:auto!important; overflow:visible!important; overflow-x:hidden!important; display:block!important; }
      body[data-template="page.gift-guide"] #MainContent,
      body[data-template="page.gift-guide"] .content-for-layout,
      body[data-template="index"] #MainContent,
      body[data-template="index"] .content-for-layout { display:block!important; flex:none!important; padding:0!important; margin:0!important; }
      body[data-template="page.gift-guide"] .shopify-section,
      body[data-template="index"] .shopify-section { margin:0!important; padding:0!important; display:block!important; }
      body[data-template="page.gift-guide"] #header-group,
      body[data-template="index"] #header-group { display:none!important; }
      body[data-template="page.gift-guide"] footer,
      body[data-template="index"] footer { display:none!important; }
    </style>
    {% endif %}

    {{ content_for_header }}
    <style>
      :root {
        --color-foreground: #121212;
        --color-foreground-rgb: 18, 18, 18;
        --color-background: #ffffff;
        --color-background-rgb: 255, 255, 255;
        --color-shadow: #121212;
        --color-shadow-rgb: 18, 18, 18;
        --color-primary-button-background: #121212;
        --color-primary-button-text: #ffffff;
        --color-primary-button-border: #121212;
        --color-primary-button-hover-background: #333333;
        --color-primary-button-hover-text: #ffffff;
        --color-primary-button-hover-border: #333333;
        --color-primary-button-focus-outline: #121212;
        --color-secondary-button-background: transparent;
        --color-secondary-button-text: #121212;
        --color-secondary-button-border: #121212;
        --color-secondary-button-hover-background: #121212;
        --color-secondary-button-hover-text: #ffffff;
        --color-secondary-button-hover-border: #121212;
        --color-input-background: #ffffff;
        --color-input-border: #d9d9d9;
        --color-input-text: #121212;
        --color-input-text-rgb: 18, 18, 18;
        --color-success: #008060;
        --color-error: #d82c0d;
        --font-paragraph--family: 'Poppins', sans-serif;
        --font-paragraph--style: normal;
        --font-paragraph--weight: 400;
        --font-paragraph--size: 1rem;
        --font-paragraph--line-height: 1.6;
        --font-paragraph--case: none;
        --font-h1--family: 'Playfair Display', serif;
        --font-h1--style: normal;
        --font-h1--weight: 700;
        --font-h1--size: 3rem;
        --font-h1--line-height: 1.1;
        --font-h1--letter-spacing: -0.01em;
        --font-h1--case: none;
        --font-h2--family: 'Playfair Display', serif;
        --font-h2--style: normal;
        --font-h2--weight: 700;
        --font-h2--size: 2.25rem;
        --font-h2--line-height: 1.15;
        --font-h2--letter-spacing: -0.01em;
        --font-h2--case: none;
        --font-h3--family: 'Playfair Display', serif;
        --font-h3--style: normal;
        --font-h3--weight: 700;
        --font-h3--size: 1.75rem;
        --font-h3--line-height: 1.2;
        --font-h3--letter-spacing: 0;
        --font-h3--case: none;
        --font-h4--family: 'Poppins', sans-serif;
        --font-h4--style: normal;
        --font-h4--weight: 600;
        --font-h4--size: 1.25rem;
        --font-h4--line-height: 1.3;
        --font-h4--letter-spacing: 0;
        --font-h4--case: none;
        --font-h5--family: 'Poppins', sans-serif;
        --font-h5--style: normal;
        --font-h5--weight: 600;
        --font-h5--size: 1rem;
        --font-h5--line-height: 1.4;
        --font-h5--letter-spacing: 0.02em;
        --font-h5--case: uppercase;
        --font-h6--family: 'Poppins', sans-serif;
        --font-h6--style: normal;
        --font-h6--weight: 600;
        --font-h6--size: 0.875rem;
        --font-h6--line-height: 1.4;
        --font-h6--letter-spacing: 0.04em;
        --font-h6--case: uppercase;
        --button-font-family-primary: 'Poppins', sans-serif;
        --button-text-case-primary: uppercase;
        --button-font-family-secondary: 'Poppins', sans-serif;
        --button-text-case-secondary: none;
        --button-padding-block: 0.875rem;
        --button-padding-inline: 1.75rem;
        --button-border-width: 1px;
        --style-border-radius-buttons-primary: 0px;
        --style-border-radius-buttons-secondary: 0px;
        --style-border-radius-inputs: 0px;
        --style-border-radius-popover: 4px;
        --style-border-radius-50: 50%;
        --style-border-width-primary: 0px;
        --style-border-width-secondary: 1px;
        --animation-speed: 200ms;
        --animation-easing: ease;
        --animation-timing-fade-in: ease-in;
        --animation-timing-fade-out: ease-out;
        --opacity-5: 0.05;
        --opacity-10: 0.1;
        --opacity-25: 0.25;
        --opacity-30: 0.3;
        --opacity-40: 0.4;
        --opacity-40-60: 0.5;
        --opacity-60: 0.6;
        --opacity-70: 0.7;
        --opacity-80: 0.8;
        --opacity-85: 0.85;
        --opacity-muted-text: 0.55;
        --opacity-subdued-text: 0.65;
        --gap-2xs: 4px;
        --gap-xs: 8px;
        --gap-sm: 12px;
        --gap-md: 16px;
        --gap-lg: 24px;
        --gap-xl: 32px;
        --padding-3xs: 4px;
        --padding-2xs: 6px;
        --padding-xs: 8px;
        --padding-sm: 12px;
        --padding-md: 16px;
        --padding-lg: 24px;
        --padding-xl: 32px;
        --padding-2xl: 48px;
        --padding-3xl: 64px;
        --margin-lg: 24px;
        --margin-4xl: 40px;
        --icon-size-2xs: 12px;
        --icon-size-xs: 16px;
        --icon-size-sm: 20px;
        --icon-size-md: 24px;
        --focus-outline-width: 2px;
        --focus-outline-offset: 3px;
        --minimum-touch-target: 44px;
        --checkbox-size: 18px;
        --checkbox-border: 1.5px solid #121212;
        --checkbox-border-radius: 2px;
        --input-padding: 12px 16px;
        --input-padding-x: 16px;
        --input-box-shadow: inset 0 0 0 1px #d9d9d9;
        --input-box-shadow-focus: inset 0 0 0 2px #121212;
        --input-disabled-background-color: #f3f3f3;
        --input-disabled-border-color: #d9d9d9;
        --input-disabled-text-color: #6d6d6d;
        --shadow-popover: 0 4px 24px rgba(18,18,18,0.12);
        --backdrop-opacity: 0.5;
        --layer-flat: 1;
        --layer-raised: 2;
        --layer-section-background: 0;
        --layer-menu-drawer: 100;
        --normal-page-width: 1200px;
        --wide-page-width: 2400px;
        --narrow-page-width: 1400px;
        --normal-content-width: 720px;
        --max-width--display-tight: 480px;
        --section-height-small: 300px;
        --section-height-medium: 500px;
        --section-height-large: 700px;
        --spacing-scale-default: 1;
        --spacing-scale-md: 0.85;
        --ease-out-quad: cubic-bezier(0.25, 0.46, 0.45, 0.94);
        --font-size--xs: 0.75rem;
        --font-heading--spacing: 0.5rem;
        --font-body--family: 'Poppins', sans-serif;
        --sidebar-width: 400px;
        --theme-drawer-width: 400px;
      }
    </style>
  </head>

  <body class="page-width-{{ settings.page_width }}" data-template="{{ template }}">
    <a class="skip-to-content-link visually-hidden" href="#MainContent">{{ 'accessibility.skip_to_text' | t }}</a>

    <div class="page-wrapper">
      <div id="header-group">
        {% sections 'header-group' %}
      </div>

      <script>
        (function setHeaderHeighCustomProperties() {
          const header = document.querySelector('header-component');
          const headerGroup = document.querySelector('#header-group');
          if (!header || !headerGroup) return;
          const headerTopRow = header.querySelector('.header__row--top');
          const headerHeight = header.offsetHeight;
          let headerGroupHeight = 0;
          const children = headerGroup.children;
          for (let i = 0; i < children.length; i++) {
            const element = children[i];
            if (element === header || !(element instanceof HTMLElement)) continue;
            headerGroupHeight += element.offsetHeight;
          }
          if (header.hasAttribute('transparent') && header.parentElement?.nextElementSibling) {
            headerGroupHeight += headerHeight;
          }
          document.body.style.setProperty('--header-height', `${headerHeight}px`);
          document.body.style.setProperty('--header-group-height', `${headerGroupHeight}px`);
          if (headerTopRow) {
            window.requestAnimationFrame(function () {
              document.body.style.setProperty('--top-row-height', `${headerTopRow.offsetHeight}px`);
            });
          }
          const hasHeaderSection = headerGroup.querySelector('.header-section');
          if (!hasHeaderSection || !header?.hasAttribute('transparent')) {
            document.body.style.setProperty('--transparent-header-offset-boolean', '0');
            return;
          }
          const hasImmediateSection = hasHeaderSection.nextElementSibling?.classList.contains('shopify-section');
          const shouldApplyOffset = !hasImmediateSection ? '1' : '0';
          document.body.style.setProperty('--transparent-header-offset-boolean', shouldApplyOffset);
        })();

        (function setHeaderMenuStyle() {
          const headerComponent = document.querySelector('#header-component');
          if (headerComponent) {
            const isTouchDevice = 'ontouchstart' in window && navigator.maxTouchPoints > 0;
            const overflowList = headerComponent?.querySelector('overflow-list');
            const hasReachedMinimum = overflowList && overflowList.hasAttribute('minimum-reached');
            headerComponent.dataset.menuStyle = isTouchDevice || hasReachedMinimum ? 'drawer' : 'menu';
          }
        })();
      </script>

      <main id="MainContent" class="content-for-layout" role="main" tabindex="-1">
        {{ content_for_layout }}
      </main>

      <footer>
        {% sections 'footer-group' %}
      </footer>
    </div>

    {% render 'cart-drawer', render_wrapper: true %}
    {% render 'theme-drawer' %}
    {% render 'search-modal' %}

    {% if settings.quick_add or settings.mobile_quick_add %}
      {% render 'quick-add-modal' %}
    {% endif %}
  </body>
</html>
