<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>{{ page_title | escape }}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700&family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
    {% assign is_gift_guide_template = false %}
    {% if template == 'page.gift-guide' or template.suffix == 'gift-guide' or template.name == 'gift-guide' or page_template == 'gift-guide' %}
      {% assign is_gift_guide_template = true %}
    {% endif %}
    {% assign is_gift_guide_page = false %}
    {% if page.handle == 'gift-guide' or request.path == '/pages/gift-guide' %}
      {% assign is_gift_guide_page = true %}
    {% endif %}
    {% assign is_gift_guide = is_gift_guide_template or is_gift_guide_page %}
    {% if is_gift_guide %}
      <link rel="stylesheet" href="{{ 'gift-guide.css' | asset_url }}">
    {% endif %}
    {{ content_for_header }}
  </head>
  <body{% if is_gift_guide %} class="gift-guide-page" data-template="page.gift-guide"{% endif %}>
    <main id="MainContent" role="main"{% if is_gift_guide %} data-template="page.gift-guide"{% endif %}>
      {% if is_gift_guide_page and not is_gift_guide_template %}
        {% section 'gift-guide-banner' %}
        {% section 'gift-guide-grid' %}
      {% else %}
        {{ content_for_layout }}
      {% endif %}
    </main>
    {% if is_gift_guide %}
      <script src="{{ 'gift-guide-quickview.js' | asset_url }}" defer></script>
    {% endif %}
  </body>
</html>
