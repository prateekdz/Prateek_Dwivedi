<div style="display:flex;flex-direction:column;align-items:center;justify-content:center;min-height:60vh;text-align:center;padding:2rem;font-family:inherit;">
  <h1 style="font-size:6rem;font-weight:700;margin:0;line-height:1;">404</h1>
  <h2 style="font-size:1.5rem;margin:1rem 0;">{{ 'templates.404.title' | t }}</h2>
  <p style="margin-bottom:2rem;">{{ 'templates.404.subtext' | t }}</p>
  <a href="{{ routes.root_url }}" style="display:inline-block;padding:0.75rem 2rem;background:#000;color:#fff;text-decoration:none;border-radius:4px;">
    {{ 'general.404.home' | t | default: 'Continue shopping' }}
  </a>
</div>
