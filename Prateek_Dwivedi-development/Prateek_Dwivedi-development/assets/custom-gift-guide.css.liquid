.cg-hero {
  position: relative;
  min-height: 100vh;
  width: 100%;
  background: url('{{ 'gift-guide-banner.svg' | asset_url }}') center/cover no-repeat;
  overflow: hidden;
}

.cg-hero__frame {
  position: relative;
  min-height: 100vh;
  width: 100%;
  padding: 0;
  margin: 0;
}

.cg-hero__header {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  height: 72px;
  display: grid;
  grid-template-columns: auto 1fr auto;
  align-items: center;
  gap: 24px;
  padding: 0 40px;
  background: #f2f2f2;
  z-index: 10;
}

.cg-hero__brand {
  font-family: 'Poppins', sans-serif;
  font-size: 0.95rem;
  font-weight: 700;
  letter-spacing: 0.3em;
  text-transform: uppercase;
}

.cg-hero__headline-copy {
  font-family: 'Poppins', sans-serif;
  font-size: 1rem;
  font-weight: 500;
  text-align: center;
  letter-spacing: 0.02em;
}

.cg-hero__header-action {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 220px;
  height: 52px;
  background: #ece21c;
  color: #111;
  text-decoration: none;
  font-family: 'Poppins', sans-serif;
  font-weight: 700;
  letter-spacing: 2px;
  text-transform: uppercase;
  border-radius: 8px;
}

.cg-hero__card {
  position: absolute;
  left: 40px;
  bottom: 40px;
  width: min(540px, calc(100% - 80px));
  min-height: 520px;
  background: #efefef;
  border-radius: 40px;
  padding: 50px;
  box-shadow: 0 25px 60px rgba(0, 0, 0, 0.12);
  display: grid;
  gap: 24px;
  z-index: 5;
}

.cg-hero__card-title {
  margin: 0;
  font-family: 'Playfair Display', serif;
  font-size: clamp(4.2rem, 5vw, 6rem);
  line-height: 0.9;
  font-weight: 900;
  color: #000;
}

.cg-hero__card-description {
  margin: 0;
  max-width: 430px;
  font-family: 'Poppins', sans-serif;
  font-size: 22px;
  line-height: 1.8;
  color: #111;
}

.cg-hero__card-description--secondary {
  margin-top: 0.75rem;
}

.cg-hero__card-cta {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 280px;
  height: 74px;
  background: #111;
  color: #fff;
  border-radius: 999px;
  text-decoration: none;
  font-family: 'Poppins', sans-serif;
  font-weight: 800;
  letter-spacing: 4px;
  text-transform: uppercase;
}

.cg-hero__bottom-strip {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 42px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #e8e8e8;
  color: #111;
  font-family: 'Poppins', sans-serif;
  font-size: 14px;
  font-weight: 600;
  letter-spacing: 2px;
  text-transform: uppercase;
}

@media (max-width: 980px) {
  .cg-hero__header {
    padding: 0 24px;
    gap: 16px;
  }

  .cg-hero__headline-copy {
    font-size: 0.95rem;
  }

  .cg-hero__card {
    left: 24px;
    bottom: 24px;
    width: calc(100% - 48px);
    padding: 36px;
  }

  .cg-hero__card-title {
    font-size: clamp(3rem, 6vw, 5rem);
  }

  .cg-hero__card-description {
    font-size: 20px;
  }

  .cg-hero__card-cta {
    width: 100%;
  }
}

@media (max-width: 680px) {
  .cg-hero__header {
    grid-template-columns: 1fr;
    justify-items: center;
    text-align: center;
    padding: 0 16px;
    height: auto;
    row-gap: 12px;
  }

  .cg-hero__brand,
  .cg-hero__headline-copy {
    width: 100%;
  }

  .cg-hero__card {
    left: 50%;
    transform: translateX(-50%);
    width: min(100%, calc(100% - 32px));
    padding: 28px;
    border-radius: 32px;
  }

  .cg-hero__card-title {
    font-size: 3.2rem;
  }

  .cg-hero__card-description {
    font-size: 18px;
  }

  .cg-hero__card-cta {
    width: 100%;
    height: 64px;
  }
}
