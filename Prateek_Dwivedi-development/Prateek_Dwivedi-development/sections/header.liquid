<header class="navbar" role="banner" aria-label="Primary navigation">
  <nav class="navbar__inner" aria-label="Primary navigation">
    <div class="navbar__brand">{{ section.settings.brand_text }}</div>
    <div class="navbar__tagline">{{ section.settings.top_text }}</div>
    <a class="navbar__cta" href="{{ section.settings.top_button_url }}">
      <span>{{ section.settings.top_button_text }}</span>
      <span class="navbar__cta-icon" aria-hidden="true">&#8594;</span>
    </a>
  </nav>
</header>

{% schema %}
{
  "name": "Simple Navbar",
  "settings": [
    {
      "type": "text",
      "id": "brand_text",
      "label": "Brand text",
      "default": "TISSO VISON"
    },
    {
      "type": "text",
      "id": "top_text",
      "label": "Top text",
      "default": "Find the ideal gift for your loved ones."
    },
    {
      "type": "text",
      "id": "top_button_text",
      "label": "Button text",
      "default": "CHOOSE GIFT"
    },
    {
      "type": "url",
      "id": "top_button_url",
      "label": "Button URL",
      "default": "#gift-guide-grid"
    }
  ],
  "presets": [
    {
      "name": "Navbar",
      "category": "Custom"
    }
  ]
}
{% endschema %}

{% stylesheet %}
.navbar {
  background: #fff;
  width: 100%;
  position: relative;
  z-index: 50;
}

.navbar__inner {
  max-width: 1560px;
  margin: 0 auto;
  display: grid;
  grid-template-columns: auto 1fr auto;
  align-items: center;
  gap: 24px;
  padding: 22px 40px;
}

.navbar__brand {
  font-family: var(--font-heading--family, sans-serif);
  font-size: 0.95rem;
  font-weight: 700;
  letter-spacing: 0.24em;
  text-transform: uppercase;
  white-space: nowrap;
}

.navbar__tagline {
  justify-self: center;
  text-align: center;
  font-size: 0.95rem;
  color: #111;
  letter-spacing: 0.03em;
}

.navbar__cta {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  padding: 14px 30px;
  background: #f0e040;
  color: #111;
  font-size: 0.85rem;
  font-weight: 700;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  text-decoration: none;
  white-space: nowrap;
  border-radius: 0;
  box-shadow: none;
}

.navbar__cta-icon {
  display: inline-block;
  line-height: 1;
}

@media (max-width: 900px) {
  .navbar__inner {
    grid-template-columns: 1fr;
    text-align: center;
    justify-items: center;
    padding: 20px 24px;
  }

  .navbar__tagline {
    order: 3;
    margin-top: 8px;
    max-width: 100%;
  }

  .navbar__cta {
    order: 2;
    margin-top: 12px;
  }
}
{% endstylesheet %}
