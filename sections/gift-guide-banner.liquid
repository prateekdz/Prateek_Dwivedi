{{- 'gift-guide.css' | asset_url | stylesheet_tag -}}

<section class="gg-banner" aria-label="{{ section.settings.hero_heading }}">
  <header class="gg-banner__topbar">
    <div class="gg-banner__brand">{{ section.settings.brand_text }}</div>
    <div class="gg-banner__tagline">{{ section.settings.top_text }}</div>
    <a class="gg-banner__choose-btn" href="{{ section.settings.top_button_url }}">
      {{ section.settings.top_button_text }}
      <span class="gg-banner__arrow" aria-hidden="true"></span>
    </a>
  </header>

  <div class="gg-banner__body">
    <div class="gg-banner__text">
      <h1 class="gg-banner__heading">{{ section.settings.hero_heading }}</h1>
      <p class="gg-banner__copy">{{ section.settings.hero_copy | newline_to_br }}</p>
      <a class="gg-banner__shop-btn" href="{{ section.settings.hero_cta_url | default: '#gift-guide-grid' }}">
        {{ section.settings.hero_cta_text }}
        <span class="gg-banner__arrow" aria-hidden="true"></span>
      </a>
    </div>

    <div class="gg-banner__illustration" aria-hidden="true">
      <img
        class="gg-banner__illustration-image"
        src="{{ 'Frame.svg' | asset_url }}"
        alt=""
        aria-hidden="true"
      />
    </div>
  </div>

  <div class="gg-banner__ticker">{{ section.settings.ticker_text }}</div>
</section>

{% schema %}
{
  "name": "Gift Guide Banner",
  "settings": [
    {
      "type": "text",
      "id": "brand_text",
      "label": "Brand name",
      "default": "TISSO VISON"
    },
    {
      "type": "text",
      "id": "top_text",
      "label": "Top tagline",
      "default": "Find the ideal gift for your loved ones."
    },
    {
      "type": "text",
      "id": "top_button_text",
      "label": "Top button label",
      "default": "CHOOSE GIFT"
    },
    {
      "type": "url",
      "id": "top_button_url",
      "label": "Top button link",
      "default": ""
    },
    {
      "type": "text",
      "id": "hero_heading",
      "label": "Hero heading",
      "default": "The Gift Guide"
    },
    {
      "type": "textarea",
      "id": "hero_copy",
      "label": "Hero description",
      "default": "Discover Joy: Your Ultimate Holiday Gift Destination. Explore our curated selection and find the perfect gifts to delight your loved ones this holiday season."
    },
    {
      "type": "text",
      "id": "hero_cta_text",
      "label": "CTA button label",
      "default": "SHOP NOW"
    },
    {
      "type": "url",
      "id": "hero_cta_url",
      "label": "CTA button link",
      "default": ""
    },
    {
      "type": "text",
      "id": "ticker_text",
      "label": "Ticker text",
      "default": "SUSTAINABLE, ETHICALLY MADE CLOTHES IN SIZES XXS TO 6XL"
    },
    {
      "type": "image_picker",
      "id": "illustration_image",
      "label": "Illustration image (optional)"
    }
  ],
  "presets": [
    {
      "name": "Gift Guide Banner",
      "category": "Custom"
    }
  ]
}
{% endschema %}
