<section class="gift-guide-banner" aria-label="Gift guide banner">
  <div class="gift-guide-banner__header">
    <span class="gift-guide-banner__brand">{{ section.settings.logo_text }}</span>
    <p class="gift-guide-banner__headline">{{ section.settings.header_text }}</p>
    <a class="gift-guide-banner__top-button" href="{{ section.settings.top_button_url }}">
      <span>{{ section.settings.top_button_text }}</span>
      <span class="gift-guide-btn__arrow" aria-hidden="true">→</span>
    </a>
  </div>

  <div class="gift-guide-banner__hero">
    {% render 'gift-guide-illustration' %}

    <div class="gift-guide-banner__content">
      <h1 class="gift-guide-banner__title">{{ section.settings.hero_heading }}</h1>
      <div class="gift-guide-banner__copy">{{ section.settings.hero_copy | newline_to_br }}</div>
      <a class="gift-guide-banner__cta" href="{{ section.settings.hero_cta_url }}">
        <span>{{ section.settings.hero_cta_text }}</span>
        <span class="gift-guide-btn__arrow" aria-hidden="true">→</span>
      </a>
    </div>
  </div>

  <div class="gift-guide-banner__strip">
    <span>{{ section.settings.strip_text }}</span>
  </div>
</section>

{% schema %}
{
  "name": "Gift Guide Banner",
  "settings": [
    {
      "type": "text",
      "id": "logo_text",
      "label": "Logo text",
      "default": "TISSO VISON"
    },
    {
      "type": "text",
      "id": "header_text",
      "label": "Header text",
      "default": "Find the ideal gift for your loved ones."
    },
    {
      "type": "url",
      "id": "top_button_url",
      "label": "Top button URL",
      "default": "#gift-guide-grid"
    },
    {
      "type": "text",
      "id": "top_button_text",
      "label": "Top button text",
      "default": "CHOOSE GIFT"
    },
    {
      "type": "text",
      "id": "hero_heading",
      "label": "Hero heading",
      "default": "The Gift Guide"
    },
    {
      "type": "textarea",
      "id": "hero_copy",
      "label": "Hero description",
      "default": "Discover Joy: Your Ultimate Holiday Gift Destination. Explore our curated selection and find the perfect gifts to delight your loved ones this holiday season."
    },
    {
      "type": "url",
      "id": "hero_cta_url",
      "label": "Hero CTA URL",
      "default": "#gift-guide-grid"
    },
    {
      "type": "text",
      "id": "hero_cta_text",
      "label": "Hero CTA text",
      "default": "SHOP NOW"
    },
    {
      "type": "text",
      "id": "strip_text",
      "label": "Bottom strip text",
      "default": "SUSTAINABLE, ETHICALLY MADE CLOTHES IN SIZES XXS TO 6XL"
    }
  ],
  "presets": [
    {
      "name": "Gift Guide Banner",
      "category": "Custom"
    }
  ]
}
{% endschema %}
