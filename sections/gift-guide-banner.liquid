<section class="gift-guide-banner" aria-label="Gift guide banner">
  <div class="gift-guide-banner__topbar">
    <div class="gift-guide-banner__brand">{{ section.settings.brand_text }}</div>
    <div class="gift-guide-banner__headline">{{ section.settings.top_text }}</div>
    <a class="gift-guide-banner__top-button" href="{{ section.settings.top_button_url }}">{{ section.settings.top_button_text }}</a>
  </div>

  <div class="gift-guide-banner__hero">
    <h1 class="gift-guide-banner__title">{{ section.settings.hero_heading }}</h1>
    <div class="gift-guide-banner__copy">{{ section.settings.hero_copy | newline_to_br }}</div>
    <a class="gift-guide-banner__cta" href="{{ section.settings.hero_cta_url }}">{{ section.settings.hero_cta_text }}</a>
  </div>

  <div class="gift-guide-banner__visual" aria-hidden="true">
    <div class="gift-guide-banner__shape gift-guide-banner__shape--circle"></div>
    <div class="gift-guide-banner__shape gift-guide-banner__shape--line"></div>
  </div>
</section>

<link rel="stylesheet" href="{{ 'gift-guide.css' | asset_url }}">

{% schema %}
{
  "name": "Gift Guide Banner",
  "settings": [
    {
      "type": "text",
      "id": "brand_text",
      "label": "Brand name",
      "default": "TISSO VISON"
    },
    {
      "type": "text",
      "id": "top_text",
      "label": "Top message",
      "default": "Find the ideal gift for your loved ones."
    },
    {
      "type": "text",
      "id": "top_button_text",
      "label": "Top button label",
      "default": "CHOOSE GIFT"
    },
    {
      "type": "url",
      "id": "top_button_url",
      "label": "Top button link",
      "default": "#gift-guide-grid"
    },
    {
      "type": "text",
      "id": "hero_heading",
      "label": "Hero heading",
      "default": "The Gift Guide"
    },
    {
      "type": "textarea",
      "id": "hero_copy",
      "label": "Hero description",
      "default": "Discover Joy: Your Ultimate Holiday Gift Destination. Explore our curated selection and find the perfect gifts to delight your loved ones this holiday season."
    },
    {
      "type": "text",
      "id": "hero_cta_text",
      "label": "Hero CTA label",
      "default": "SHOP NOW"
    },
    {
      "type": "url",
      "id": "hero_cta_url",
      "label": "Hero CTA link",
      "default": "#gift-guide-grid"
    }
  ],
  "presets": [
    {
      "name": "Gift Guide Banner",
      "category": "Custom"
    }
  ]
}
{% endschema %}
