<section class="gift-guide-banner" aria-label="Gift Guide Banner" data-section-id="{{ section.id }}">
  {% assign banner_background = section.settings.background | image_url: width: 2400 %}
  {% if banner_background == blank %}
    {% assign banner_background = 'gift-guide-banner.svg' | asset_url %}
  {% endif %}

  <div class="gift-guide-banner__topbar">
    <div class="gift-guide-banner__logo">{{ section.settings.logo_text }}</div>
    <div class="gift-guide-banner__headline">{{ section.settings.topbar_text }}</div>
    <a class="gift-guide-banner__topbar-cta gift-guide-button" href="{{ section.settings.topbar_button_link }}">
      <span>{{ section.settings.topbar_button_label }}</span>
      <span class="gift-guide-button__arrow" aria-hidden="true">→</span>
    </a>
  </div>

  <div class="gift-guide-banner__hero">
    <img class="gift-guide-banner__background-image" src="{{ banner_background }}" alt="" aria-hidden="true" loading="eager">

    <article class="gift-guide-banner__card">
      <div class="gift-guide-banner__card-inner">
        <h1 class="gift-guide-banner__title">{{ section.settings.heading }}</h1>
        <p class="gift-guide-banner__description">{{ section.settings.description | newline_to_br }}</p>
        <a class="gift-guide-banner__shop-now gift-guide-button gift-guide-button--black" href="{{ section.settings.shop_now_link }}">
          <span>{{ section.settings.shop_now_label }}</span>
          <span class="gift-guide-button__arrow" aria-hidden="true">→</span>
        </a>
      </div>
    </article>

    <p class="gift-guide-banner__footer">{{ section.settings.bottom_text }}</p>
  </div>
</section>

{% schema %}
{
  "name": "Gift Guide Banner",
  "settings": [
    { "type": "text", "id": "logo_text", "label": "Logo text", "default": "TISSO VISON" },
    { "type": "text", "id": "topbar_text", "label": "Top center text", "default": "Find the ideal gift for your loved ones." },
    { "type": "text", "id": "topbar_button_label", "label": "Topbar CTA label", "default": "CHOOSE GIFT" },
    { "type": "url", "id": "topbar_button_link", "label": "Topbar CTA link", "default": "#gift-guide-grid" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The Gift Guide" },
    { "type": "textarea", "id": "description", "label": "Description", "default": "Discover Joy: Your Ultimate Holiday Gift Destination. Explore our curated selection and find the perfect gifts to delight your loved ones this holiday season." },
    { "type": "text", "id": "shop_now_label", "label": "Shop now label", "default": "SHOP NOW" },
    { "type": "url", "id": "shop_now_link", "label": "Shop now link", "default": "#gift-guide-grid" },
    { "type": "text", "id": "bottom_text", "label": "Bottom text", "default": "SUSTAINABLE, ETHICALLY MADE CLOTHES IN SIZES XXS TO 6XL" },
    { "type": "image_picker", "id": "background", "label": "Background illustration" }
  ],
  "presets": [
    { "name": "Gift Guide Banner" }
  ]
}
{% endschema %}
