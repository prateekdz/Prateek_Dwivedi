{% comment %}
  Gift Guide — Grid section.
  Renders up to 6 merchant-selected products as square photo tiles with a "+"
  hotspot. Clicking a tile opens the quick-view popup (see gift-guide.js),
  which resolves variants dynamically from the product's real option/variant
  data and adds to cart via the Ajax Cart API.
{% endcomment %}
<link rel="stylesheet" href="{{ 'gift-guide.css' | asset_url }}">

<section
  id="gift-guide-grid"
  class="gift-guide-grid"
  aria-label="Gift guide products"
  data-gift-guide-grid
  data-auto-add-product="{{ section.settings.auto_add_product.handle }}"
  data-currency="{{ cart.currency.iso_code }}"
>
  <div class="gift-guide-grid__container">
    <h2 class="gift-guide-grid__title">{{ section.settings.heading }}</h2>

    <div class="gift-guide-grid__cards">
      {% if section.blocks.size > 0 %}
        {% for block in section.blocks %}
          {% assign card_product = block.settings.product %}
          {% if card_product == blank and collections.all.products.size > forloop.index0 %}
            {% assign card_product = collections.all.products[forloop.index0] %}
          {% endif %}
          {% if card_product != blank %}
            <button type="button" class="gift-guide-card" data-product-handle="{{ card_product.handle }}" {{ block.shopify_attributes }}>
              <span class="gift-guide-card__overlay" aria-hidden="true">+</span>
              {% if card_product.featured_image != blank %}
                <img
                  class="gift-guide-card__image"
                  src="{{ card_product.featured_image | image_url: width: 720 }}"
                  alt="{{ card_product.title | escape }}"
                  loading="lazy"
                  width="720"
                  height="720"
                >
              {% else %}
                <span class="gift-guide-card__image-fallback">{{ card_product.title }}</span>
              {% endif %}
            </button>
          {% endif %}
        {% endfor %}
      {% endif %}
    </div>
  </div>

  {%- comment -%} Quick-view popup: markup only, content is filled in by gift-guide.js {%- endcomment -%}
  <div class="gift-guide-popup" id="gift-guide-popup" aria-hidden="true">
    <div class="gift-guide-popup__overlay" data-popup-close></div>
    <div class="gift-guide-popup__card" role="dialog" aria-modal="true" aria-labelledby="gift-guide-popup-title">
      <button type="button" class="gift-guide-popup__close" data-popup-close aria-label="Close">&times;</button>

      <div class="gift-guide-popup__top">
        <div class="gift-guide-popup__thumb">
          <img class="gift-guide-popup__image" alt="" src="">
        </div>
        <div class="gift-guide-popup__info">
          <h2 id="gift-guide-popup-title" class="gift-guide-popup__title"></h2>
          <div class="gift-guide-popup__price"></div>
          <p class="gift-guide-popup__description"></p>
        </div>
      </div>

      <form class="gift-guide-popup__form" novalidate>
        <div class="gift-guide-popup__options" data-popup-options></div>
        <button type="button" class="gift-guide-popup__add-to-cart" data-add-to-cart>Add to cart</button>
        <p class="gift-guide-popup__message" data-popup-message aria-live="polite"></p>
      </form>
    </div>
  </div>

  <script defer src="{{ 'gift-guide.js' | asset_url }}"></script>
</section>

{% schema %}
{
  "name": "Gift Guide Grid",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Tisso vison in the wild"
    },
    {
      "type": "product",
      "id": "auto_add_product",
      "label": "Auto-add product",
      "info": "Automatically added to cart when a shopper adds a variant matching Black + Medium. Defaults to \"Soft Winter Jacket\" behaviour if left blank and a product with that handle exists."
    }
  ],
  "blocks": [
    {
      "type": "product_card",
      "name": "Product card",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Gift Guide Grid",
      "category": "Custom",
      "blocks": [
        { "type": "product_card" },
        { "type": "product_card" },
        { "type": "product_card" },
        { "type": "product_card" },
        { "type": "product_card" },
        { "type": "product_card" }
      ]
    }
  ]
}
{% endschema %}
