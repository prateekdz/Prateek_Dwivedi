<section id="gift-guide-grid" class="gift-guide-grid" aria-label="Gift guide products" data-gift-guide-grid data-auto-add-product="{{ section.settings.auto_add_product.handle | default: '' }}" data-currency="{{ shop.currency }}">
  <div class="gift-guide-grid__container">
    <h2 class="gift-guide-grid__title">{{ section.settings.grid_heading }}</h2>
    <div class="gift-guide-grid__cards">
      {% if section.blocks.size > 0 %}
        {% for block in section.blocks %}
          {% if block.settings.product != blank %}
            {% assign card_product = block.settings.product %}
            <button type="button" class="gift-guide-card" data-product-handle="{{ card_product.handle }}" {{ block.shopify_attributes }}>
              {% if card_product.featured_image != blank %}
                <img class="gift-guide-card__media" src="{{ card_product.featured_image | image_url: width: 900 }}" alt="{{ card_product.title | escape }}" loading="lazy" width="900" height="900">
              {% else %}
                <span class="gift-guide-card--empty">{{ card_product.title }}</span>
              {% endif %}
              <span class="gift-guide-card__hotspot">+</span>
            </button>
          {% else %}
            <div class="gift-guide-card gift-guide-card--empty" {{ block.shopify_attributes }}>
              Select a product in the section settings
            </div>
          {% endif %}
        {% endfor %}
      {% else %}
        <div class="gift-guide-grid__empty">Add up to six products in the theme customizer to populate this grid.</div>
      {% endif %}
    </div>
  </div>

  <div class="gift-guide-popup" id="gift-guide-popup" aria-hidden="true">
    <div class="gift-guide-popup__overlay" data-popup-close></div>
    <div class="gift-guide-popup__dialog" role="dialog" aria-modal="true" aria-labelledby="gift-guide-popup-title">
      <button type="button" class="gift-guide-popup__close" data-popup-close aria-label="Close">×</button>
      <div class="gift-guide-popup__panel">
        <div class="gift-guide-popup__image-wrap">
          <img class="gift-guide-popup__image" src="" alt="">
        </div>
        <div class="gift-guide-popup__info">
          <h2 id="gift-guide-popup-title" class="gift-guide-popup__title"></h2>
          <div class="gift-guide-popup__price"></div>
          <p class="gift-guide-popup__description"></p>
        </div>
      </div>
      <form class="gift-guide-popup__form" novalidate>
        <div class="gift-guide-popup__options" data-popup-options></div>
        <button type="button" class="gift-guide-popup__add-to-cart" data-add-to-cart>Add to cart</button>
        <p class="gift-guide-popup__message" data-popup-message aria-live="polite"></p>
      </form>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Gift Guide Grid",
  "settings": [
    {
      "type": "text",
      "id": "grid_heading",
      "label": "Grid heading",
      "default": "Tisso vison in the wild"
    },
    {
      "type": "product",
      "id": "auto_add_product",
      "label": "Auto add product",
      "info": "Automatically add this product when Black + Medium is selected. Defaults to Soft Winter Jacket if left blank."
    }
  ],
  "blocks": [
    {
      "type": "product_card",
      "name": "Product card",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Gift Guide Grid",
      "category": "Custom",
      "blocks": [
        { "type": "product_card" },
        { "type": "product_card" },
        { "type": "product_card" },
        { "type": "product_card" },
        { "type": "product_card" },
        { "type": "product_card" }
      ]
    }
  ]
}
{% endschema %}
