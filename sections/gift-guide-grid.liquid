{%- comment -%}
  Section: Gift Guide Grid
  Layout: heading + 3×2 photo grid. Each cell has a "+" trigger that opens
  a compact popup (quick-view) with product details, variant pickers, and
  a functional Add to Cart button.
{%- endcomment -%}

<section id="gift-guide-grid"
         class="gg-grid"
         data-gift-guide-grid
         data-auto-add-handle="{{ section.settings.auto_add_product.handle | default: '' | escape }}">

  <div class="gg-grid__inner">

    {%- comment -%} Editable section heading {%- endcomment -%}
    <h2 class="gg-grid__heading">{{ section.settings.grid_heading }}</h2>

    {%- comment -%} 3-column photo grid — exactly 6 blocks {%- endcomment -%}
    <div class="gg-grid__cards">
      {%- for block in section.blocks -%}
        {%- assign p = block.settings.product -%}
        <div class="gg-grid__cell" {{ block.shopify_attributes }}>
          {%- if p != blank -%}
            {%- comment -%}
              The entire cell is a button so the whole image is clickable.
              data-product-handle is read by JS to fetch /products/[handle].js
            {%- endcomment -%}
            <button class="gg-grid__trigger"
                    type="button"
                    data-product-handle="{{ p.handle | escape }}"
                    aria-label="Quick view {{ p.title | escape }}">
              {%- if p.featured_image != blank -%}
                <img class="gg-grid__photo"
                     src="{{ p.featured_image | img_url: '800x800', crop: 'center' }}"
                     alt="{{ p.featured_image.alt | escape | default: p.title | escape }}"
                     loading="lazy">
              {%- else -%}
                <span class="gg-grid__photo gg-grid__photo--empty"></span>
              {%- endif -%}
              {%- comment -%} "+" badge — centred at bottom of image {%- endcomment -%}
              <span class="gg-grid__plus" aria-hidden="true">+</span>
            </button>
          {%- else -%}
            <div class="gg-grid__cell--empty">Select a product</div>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>

  </div>

  {%- comment -%}
    ── Popup / Quick-view ──────────────────────────────────────────────────
    Hidden by default (aria-hidden="true", display:none via CSS).
    JS adds class "is-open" to show it.
    Structure mirrors the Figma popup: small thumb + meta top row,
    variant pickers below, ADD TO CART button at bottom.
  {%- endcomment -%}
  <div id="gg-popup"
       class="gg-popup"
       role="dialog"
       aria-modal="true"
       aria-labelledby="gg-popup-title"
       aria-describedby="gg-popup-desc"
       aria-label="Product quick view"
       aria-hidden="true">

    {%- comment -%} Click backdrop to close {%- endcomment -%}
    <div class="gg-popup__backdrop" data-popup-close></div>

    <div class="gg-popup__card">

      {%- comment -%} × close button {%- endcomment -%}
      <button class="gg-popup__close"
              type="button"
              data-popup-close
              aria-label="Close quick view">&#x2715;</button>

      {%- comment -%} Top row: thumbnail | title + price + description {%- endcomment -%}
      <div class="gg-popup__top">
        <img class="gg-popup__thumb" src="" alt="" data-popup-image>
        <div class="gg-popup__meta">
          <p class="gg-popup__title" id="gg-popup-title" data-popup-title></p>
          <p class="gg-popup__price" data-popup-price></p>
          <p class="gg-popup__desc" id="gg-popup-desc" data-popup-desc></p>
        </div>
      </div>

      {%- comment -%} Variant option groups — built entirely by JS {%- endcomment -%}
      <div class="gg-popup__options" data-popup-options></div>

      {%- comment -%} Add to cart + live feedback message {%- endcomment -%}
      <button class="gg-popup__atc"
              type="button"
              data-add-to-cart
              disabled>
        ADD TO CART&nbsp;&nbsp;&#8594;
      </button>
      <p class="gg-popup__msg" data-popup-message aria-live="polite"></p>

    </div>
  </div>

  {%- comment -%} Load JS deferred so it doesn't block render {%- endcomment -%}
  <script defer src="{{ 'gift-guide.js' | asset_url }}"></script>

</section>

{% schema %}
{
  "name": "Gift Guide Grid",
  "settings": [
    {
      "type": "text",
      "id": "grid_heading",
      "label": "Section heading",
      "default": "Tisso vison in the wild"
    },
    {
      "type": "product",
      "id": "auto_add_product",
      "label": "Soft Winter Jacket product (auto-added with Black + Medium)"
    }
  ],
  "blocks": [
    {
      "type": "product_card",
      "name": "Product card",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Gift Guide Grid",
      "category": "Custom",
      "blocks": [
        { "type": "product_card" },
        { "type": "product_card" },
        { "type": "product_card" },
        { "type": "product_card" },
        { "type": "product_card" },
        { "type": "product_card" }
      ]
    }
  ]
}
{% endschema %}
