<section id="gift-guide-grid" class="gg-grid" aria-label="Gift guide products" data-gift-guide-grid data-auto-add-product="{{ section.settings.auto_add_product.handle }}">
  <div class="gg-grid__container">
    <div class="gg-grid__intro">
      <p class="gg-grid__eyebrow">{{ section.settings.eyebrow_text }}</p>
      <h2 class="gg-grid__title">{{ section.settings.grid_heading }}</h2>
    </div>

    <div class="gg-grid__cards">
      {% if section.blocks.size > 0 %}
        {% for block in section.blocks %}
          <article class="gg-card">
            {% if block.settings.product != blank %}
              {%- assign card_product = block.settings.product -%}
              <button
                type="button"
                class="gg-card__button"
                data-product-handle="{{ card_product.handle }}"
                aria-label="View {{ card_product.title }} details"
              >
                <span class="gg-card__media">
                  <span class="gg-card__overlay">+</span>
                  {% if card_product.featured_image != blank %}
                    <img
                      class="gg-card__image"
                      src="{{ card_product.featured_image | img_url: '900x' }}"
                      alt="{{ card_product.title }}"
                    />
                  {% else %}
                    <span class="gg-card__image-fallback">Image unavailable</span>
                  {% endif %}
                </span>
              </button>
            {% else %}
              <div class="gg-card gg-card--empty">
                <div class="gg-card__placeholder">Select a product in the customizer</div>
              </div>
            {% endif %}
          </article>
        {% endfor %}
      {% else %}
        <div class="gg-grid__empty">Add six products in the customizer to populate the grid.</div>
      {% endif %}
    </div>
  </div>

  <div class="gg-popup" id="gift-guide-popup" aria-hidden="true">
    <div class="gg-popup__backdrop" data-popup-close></div>
    <div class="gg-popup__dialog" role="dialog" aria-modal="true" aria-labelledby="gift-guide-popup-title">
      <button type="button" class="gg-popup__close" data-popup-close aria-label="Close popup">×</button>

      <div class="gg-popup__content">
        <div class="gg-popup__image-panel">
          <img class="gg-popup__image" src="" alt="" />
        </div>

        <div class="gg-popup__details">
          <div class="gg-popup__header">
            <h3 id="gift-guide-popup-title" class="gg-popup__title"></h3>
            <p class="gg-popup__price"></p>
          </div>
          <p class="gg-popup__description"></p>

          <div class="gg-popup__options" data-popup-options></div>
          <button type="button" class="gg-popup__cart-btn" data-add-to-cart>ADD TO CART</button>
          <p class="gg-popup__message" data-popup-message aria-live="polite"></p>
        </div>
      </div>
    </div>
  </div>

  <script defer src="{{ 'gift-guide.js' | asset_url }}"></script>
</section>

{% schema %}
{
  "name": "Gift Guide Grid",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow_text",
      "label": "Eyebrow label",
      "default": "Gift collection"
    },
    {
      "type": "text",
      "id": "grid_heading",
      "label": "Grid heading",
      "default": "Tisso vison in the wild"
    },
    {
      "type": "product",
      "id": "auto_add_product",
      "label": "Soft Winter Jacket product (auto-add)"
    }
  ],
  "blocks": [
    {
      "type": "product_card",
      "name": "Product card",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Gift Guide Grid",
      "category": "Custom",
      "blocks": [
        { "type": "product_card" },
        { "type": "product_card" },
        { "type": "product_card" },
        { "type": "product_card" },
        { "type": "product_card" },
        { "type": "product_card" }
      ]
    }
  ]
}
{% endschema %}
