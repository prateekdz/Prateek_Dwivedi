<section class="cg-hero" aria-label="Gift guide hero">
  <div class="cg-hero__frame">
    <div class="cg-hero__header">
      <div class="cg-hero__brand">TISSO VISION</div>
      <div class="cg-hero__headline-copy">Find the ideal gift for your loved ones.</div>
      <a class="cg-hero__header-action" href="#cg-shop-now">CHOOSE GIFT →</a>
    </div>

    <div class="cg-hero__card" id="cg-shop-now">
      <h1 class="cg-hero__card-title">The Gift Guide</h1>
      <p class="cg-hero__card-description">Discover Joy: Your Ultimate Holiday Gift Destination.</p>
      <p class="cg-hero__card-description cg-hero__card-description--secondary">Explore our curated selection and find the perfect gifts to delight your loved ones this holiday season.</p>
      <a class="cg-hero__card-cta" href="#MainContent">SHOP NOW →</a>
    </div>

    <div class="cg-hero__bottom-strip">SUSTAINABLE, ETHICALLY MADE CLOTHES IN SIZES XXS TO 6XL</div>
  </div>
</section>

{% schema %}
{
  "name": "Custom Gift Guide",
  "settings": [],
  "presets": [
    {
      "name": "Custom Gift Guide"
    }
  ]
}
{% endschema %}
