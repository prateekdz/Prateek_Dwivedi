{%- style -%}
body[data-template="page.gift-guide"] .shopify-section,
body[data-template="index"] .shopify-section{display:block!important;margin:0!important;padding:0!important}
.cgg-wrap{display:block;width:100%;font-family:'Poppins',Arial,sans-serif;color:#000;background:#fff;-webkit-font-smoothing:antialiased}
.cgg-wrap *,.cgg-wrap *::before,.cgg-wrap *::after{box-sizing:border-box}
.cgg-nav{display:grid;grid-template-columns:260px 1fr 260px;align-items:center;width:100%;height:60px;background:#f4f4f4;padding:0 48px;gap:0}
.cgg-logo{font-size:23px;font-weight:700;letter-spacing:.08em;line-height:1;text-transform:uppercase;white-space:nowrap;color:#000}
.cgg-tagline{font-size:15px;font-weight:400;line-height:1.4;text-align:center;color:#000}
.cgg-nav-btn{justify-self:end;display:inline-flex;align-items:center;justify-content:center;width:196px;height:42px;padding:0;gap:22px;background:#fff33f;color:#000;font-size:14px;font-weight:400;letter-spacing:0;text-transform:uppercase;text-decoration:none;white-space:nowrap;border:0;border-radius:0;cursor:pointer;transition:background .18s ease}
.cgg-nav-btn:hover{background:#f0e500;color:#000;text-decoration:none}
.cgg-hero{width:100%;overflow:hidden;background:#fff}
.cgg-hero-top{display:block;width:100%;height:360px;overflow:hidden;background:#fff;line-height:0}
.cgg-hero-top img{display:block;width:100%;height:100%;object-fit:cover;object-position:center top}
.cgg-hero-body{display:grid;grid-template-columns:452px 1fr;width:100%;min-height:350px;background:#fff}
.cgg-card{position:relative;z-index:2;display:flex;flex-direction:column;justify-content:flex-start;align-items:flex-start;gap:0;padding:42px 40px 46px 62px;background:#fff}
.cgg-card-title{font-family:'Poppins',Arial,sans-serif;font-size:56px;font-weight:700;line-height:1;letter-spacing:0;max-width:none;margin:0 0 44px;padding:0;color:#000;white-space:nowrap}
.cgg-card-desc{font-size:18px;line-height:1.28;max-width:405px;margin:0 0 48px;padding:0;font-weight:400;letter-spacing:0;color:#000}
.cgg-card-btn,.cgg-card-btn-mobile{display:inline-flex;align-items:center;justify-content:center;gap:26px;width:210px;height:48px;padding:0;background:#000;color:#fff;font-size:14px;font-weight:400;letter-spacing:0;text-transform:uppercase;text-decoration:none;border:0;border-radius:0;cursor:pointer;transition:background .18s ease}
.cgg-card-btn:hover,.cgg-card-btn-mobile:hover{background:#222;color:#fff;text-decoration:none}
.cgg-hero-right{position:relative;z-index:1;min-height:350px;overflow:hidden;background:#fff}
.cgg-hero-right img{position:absolute;right:0;bottom:0;display:block;width:min(84%,980px);height:auto;max-width:none;object-fit:contain;object-position:right bottom}
.cgg-strip{width:100%;height:31px;background:#f4f4f4;display:flex;align-items:center;justify-content:center;padding:0 24px}
.cgg-strip-text{font-size:14px;font-weight:400;letter-spacing:0;line-height:1;text-align:center;text-transform:uppercase;color:#000}
.cgg-wild{display:block;width:100%;padding:88px 48px 80px;background:#fff}
.cgg-wild-title{font-family:Georgia,'Times New Roman',serif;font-size:36px;font-weight:400;line-height:1.15;letter-spacing:0;margin:0 0 26px;padding:0;color:#000}
.cgg-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px}
.cgg-grid-item{position:relative;overflow:hidden;aspect-ratio:433/422;background:#e5e5e5;cursor:pointer}
.cgg-grid-item img{display:block;width:100%;height:100%;object-fit:cover;object-position:center top}
.cgg-grid-item .cgg-grid-img-hover{position:absolute;inset:0;opacity:0;transition:opacity .2s ease}
.cgg-grid-item:hover .cgg-grid-img-hover{opacity:1}
.cgg-hotspot{position:absolute;z-index:10;transform:translate(-50%,-50%);cursor:pointer}
.cgg-hotspot-btn{display:flex;align-items:center;justify-content:center;width:44px;height:44px;padding:0;border:0;border-radius:50%;background:rgba(255,255,255,.9);color:#000;font-size:18px;font-weight:400;line-height:1;box-shadow:0 1px 4px rgba(0,0,0,.18);cursor:pointer;appearance:none;transition:transform .18s ease,background .18s ease}
.cgg-hotspot:hover .cgg-hotspot-btn{transform:scale(1.12);background:#fff}
.cgg-popup-overlay{display:none;position:fixed;inset:0;z-index:9000;align-items:flex-start;justify-content:center;padding-top:98px;background:rgba(0,0,0,.35)}
.cgg-popup-overlay.active{display:flex}
.cgg-popup{position:relative;width:390px;max-width:calc(100vw - 32px);max-height:90vh;overflow-y:auto;background:#fff;padding:44px 29px 26px;box-shadow:0 8px 28px rgba(0,0,0,.18)}
.cgg-popup-close{position:absolute;top:10px;right:10px;display:flex;align-items:center;justify-content:center;min-width:44px;min-height:44px;padding:0;background:none;border:0;color:#000;font-size:26px;line-height:1;cursor:pointer}
.cgg-popup-top{display:flex;gap:13px;margin-bottom:12px}
.cgg-popup-img{width:150px;height:174px;object-fit:cover;flex-shrink:0;background:#eee}
.cgg-popup-info{flex:1;min-width:0;padding-top:17px}
.cgg-popup-name{font-family:'Poppins',Arial,sans-serif;font-size:18px;font-weight:400;line-height:1.25;margin:0 0 24px;color:#000}
.cgg-popup-price{font-size:20px;font-weight:400;margin:0 0 16px;color:#000}
.cgg-popup-desc{font-size:15px;line-height:1.18;color:#000;margin:0}
.cgg-popup-label{font-size:15px;font-weight:400;margin:0 0 9px;color:#000}
.cgg-popup-variants{display:flex;gap:0;flex-wrap:nowrap;margin-bottom:16px;border:1px solid #9b9b9b;overflow:hidden}
.cgg-popup-variant{flex:1;height:50px;padding:0 17px;border:0;border-right:1px solid #9b9b9b;background:#fff;font-family:inherit;font-size:20px;font-weight:400;text-align:left;color:#000;cursor:pointer}
.cgg-popup-variant:last-child{border-right:0}
.cgg-popup-variant.selected{box-shadow:inset 5px 0 0 #1e5aa7;font-weight:400}
.cgg-popup-variant:hover:not(.selected){background:#f7f7f7}
.cgg-popup-select-wrap{position:relative;margin-bottom:63px}
.cgg-popup-select{width:100%;height:51px;padding:0 64px 0 17px;border:1px solid #9b9b9b;background:#fff;font-family:inherit;font-size:20px;color:#000;border-radius:0;appearance:none;-webkit-appearance:none;cursor:pointer}
.cgg-popup-select-wrap::before{content:'';position:absolute;right:68px;top:0;width:1px;height:100%;background:#9b9b9b;pointer-events:none}
.cgg-popup-select-wrap::after{content:'';position:absolute;right:24px;top:50%;width:14px;height:14px;border-right:2px solid #000;border-bottom:2px solid #000;transform:translateY(-65%) rotate(45deg);pointer-events:none}
.cgg-popup-atc{display:flex;align-items:center;justify-content:center;width:100%;height:56px;gap:28px;background:#000;color:#fff;border:0;font-family:inherit;font-size:17px;font-weight:400;letter-spacing:0;text-transform:uppercase;cursor:pointer;transition:background .18s ease}
.cgg-popup-atc:hover{background:#222}
.cgg-popup-atc:disabled{opacity:.6;cursor:not-allowed}
.cgg-mobile-btn-wrap{display:none}
@media(max-width:1024px){
  .cgg-nav{grid-template-columns:220px 1fr 220px;padding:0 28px}
  .cgg-logo{font-size:21px}
  .cgg-nav-btn{width:180px}
  .cgg-hero-top{height:300px}
  .cgg-hero-body{grid-template-columns:390px 1fr;min-height:320px}
  .cgg-card{padding:38px 30px 40px 42px}
  .cgg-card-title{font-size:46px;margin-bottom:34px}
  .cgg-card-desc{font-size:16px;margin-bottom:40px}
  .cgg-wild{padding:68px 32px 70px}
  .cgg-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}
}
@media(max-width:680px){
  .cgg-nav{position:relative;grid-template-columns:1fr;height:69px;padding:0 48px;text-align:center;justify-items:center}
  .cgg-nav::before{content:'';position:absolute;left:14px;top:29px;width:22px;height:15px;border-top:2px solid #000;border-bottom:2px solid #000}
  .cgg-nav::after{content:'';position:absolute;left:14px;top:36px;width:22px;height:2px;background:#000}
  .cgg-logo{font-size:25px;letter-spacing:.07em}
  .cgg-tagline,.cgg-nav-btn{display:none}
  .cgg-hero-top{display:none}
  .cgg-hero-body{display:flex;flex-direction:column;min-height:unset}
  .cgg-card{order:1;padding:49px 24px 26px;align-items:center;text-align:center}
  .cgg-card-title{font-size:32px;line-height:1.1;margin:0 0 23px;white-space:nowrap;text-align:center}
  .cgg-card-desc{font-size:18px;line-height:1.25;max-width:335px;margin:0;text-align:center}
  .cgg-card .cgg-card-btn{display:none}
  .cgg-hero-right{order:2;min-height:282px;position:relative}
  .cgg-hero-right img{position:absolute;right:0;bottom:0;width:min(88%,820px);height:auto;object-fit:contain;object-position:center center}
  .cgg-mobile-btn-wrap{display:flex;justify-content:center;align-items:center;position:relative;margin-top:-128px;z-index:5;padding-bottom:77px}
  .cgg-card-btn-mobile{width:259px;height:49px;font-size:16px;gap:27px}
  .cgg-strip{height:35px}
  .cgg-strip-text{font-size:13px;line-height:1.1}
  .cgg-wild{padding:41px 16px 32px}
  .cgg-wild-title{font-size:28px;text-align:center;margin-bottom:23px}
  .cgg-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:5px}
  .cgg-grid-item{aspect-ratio:1/1.11}
  .cgg-hotspot-btn{width:44px;height:44px;font-size:16px}
  .cgg-popup-overlay{align-items:center;padding:0 16px}
  .cgg-popup{width:360px;padding:40px 24px 24px}
  .cgg-popup-img{width:130px;height:150px}
  .cgg-popup-name{font-size:17px;margin-bottom:18px}
  .cgg-popup-price{font-size:18px}
  .cgg-popup-desc{font-size:14px}
  .cgg-popup-variant,.cgg-popup-select{font-size:18px}
  .cgg-popup-select-wrap{margin-bottom:44px}
}
{%- endstyle -%}

{%- assign bg_svg = 'gift-guide-banner.svg' | asset_url -%}
{%- if section.settings.bg_image != blank -%}
  {%- assign bg_src = section.settings.bg_image | image_url: width: 2400 -%}
  {%- assign use_svg = false -%}
{%- else -%}
  {%- assign use_svg = true -%}
{%- endif -%}

<div class="cgg-wrap">

  <nav class="cgg-nav" aria-label="Gift guide navigation">
    <span class="cgg-logo">{{ section.settings.logo_text }}</span>
    <span class="cgg-tagline">{{ section.settings.header_tagline }}</span>
    <a class="cgg-nav-btn" href="{{ section.settings.header_cta_link | default: '#' }}">
      {{- section.settings.header_cta_label -}}&nbsp;&nbsp;&rarr;
    </a>
  </nav>

  <div class="cgg-hero">

    <div class="cgg-hero-top" aria-hidden="true">
      {%- if use_svg -%}
        <img src="{{ bg_svg }}" alt="" width="1052" height="400">
      {%- else -%}
        <img src="{{ bg_src }}" alt="" width="2400" height="900">
      {%- endif -%}
    </div>

    <div class="cgg-hero-body">
      <div class="cgg-card">
        <span class="cgg-card-title">{{ section.settings.card_title }}</span>
        <span class="cgg-card-desc">{{ section.settings.card_desc | newline_to_br }}</span>
        <a class="cgg-card-btn" href="{{ section.settings.card_cta_link | default: '#' }}">
          {{- section.settings.card_cta_label -}}&nbsp;&nbsp;&rarr;
        </a>
      </div>
      <div class="cgg-hero-right" aria-hidden="true">
        {%- if use_svg -%}
          <img src="{{ bg_svg }}" alt="" width="1052" height="400">
        {%- else -%}
          <img src="{{ bg_src }}" alt="" width="2400" height="900">
        {%- endif -%}
      </div>
    </div>

    <div class="cgg-mobile-btn-wrap">
      <a class="cgg-card-btn-mobile" href="{{ section.settings.card_cta_link | default: '#' }}">
        {{- section.settings.card_cta_label -}}&nbsp;&nbsp;&rarr;
      </a>
    </div>

    <div class="cgg-strip">
      <span class="cgg-strip-text">{{ section.settings.strip_text }}</span>
    </div>

  </div>

  <div class="cgg-wild">
    <h2 class="cgg-wild-title">{{ section.settings.wild_title }}</h2>
    <div class="cgg-grid">
      {%- for block in section.blocks -%}
        {%- if block.type == 'hotspot_image' -%}
          {%- assign grid_product = block.settings.product -%}
          {%- assign grid_image = block.settings.image -%}
          {%- if grid_image != blank -%}
            {%- assign resolved_img = grid_image -%}
            {%- assign resolved_img_src = grid_image | image_url: width: 900 -%}
            {%- assign resolved_img_alt = grid_image.alt | default: '' -%}
            {%- assign resolved_img_w = grid_image.width -%}
            {%- assign resolved_img_h = grid_image.height -%}
          {%- elsif grid_product != blank and grid_product.featured_image != blank -%}
            {%- assign resolved_img = grid_product.featured_image -%}
            {%- assign resolved_img_src = grid_product.featured_image | image_url: width: 900 -%}
            {%- assign resolved_img_alt = grid_product.title | escape -%}
            {%- assign resolved_img_w = grid_product.featured_image.width -%}
            {%- assign resolved_img_h = grid_product.featured_image.height -%}
          {%- elsif grid_product != blank and grid_product.selected_or_first_available_variant.featured_image != blank -%}
            {%- assign resolved_img = grid_product.selected_or_first_available_variant.featured_image -%}
            {%- assign resolved_img_src = grid_product.selected_or_first_available_variant.featured_image | image_url: width: 900 -%}
            {%- assign resolved_img_alt = grid_product.title | escape -%}
            {%- assign resolved_img_w = grid_product.selected_or_first_available_variant.featured_image.width -%}
            {%- assign resolved_img_h = grid_product.selected_or_first_available_variant.featured_image.height -%}
          {%- elsif grid_product != blank and grid_product.media != empty and grid_product.media.first.preview_image != blank -%}
            {%- assign resolved_img = grid_product.media.first.preview_image -%}
            {%- assign resolved_img_src = grid_product.media.first.preview_image | image_url: width: 900 -%}
            {%- assign resolved_img_alt = grid_product.title | escape -%}
            {%- assign resolved_img_w = grid_product.media.first.preview_image.width -%}
            {%- assign resolved_img_h = grid_product.media.first.preview_image.height -%}
          {%- elsif section.settings.fallback_collection != blank -%}
            {%- assign fallback_product = section.settings.fallback_collection.products[forloop.index0] -%}
            {%- if fallback_product != blank and fallback_product.featured_image != blank -%}
              {%- assign resolved_img = fallback_product.featured_image -%}
              {%- assign resolved_img_src = fallback_product.featured_image | image_url: width: 900 -%}
              {%- assign resolved_img_alt = fallback_product.title | escape -%}
              {%- assign resolved_img_w = fallback_product.featured_image.width -%}
              {%- assign resolved_img_h = fallback_product.featured_image.height -%}
              {%- assign grid_product = fallback_product -%}
            {%- elsif fallback_product != blank and fallback_product.selected_or_first_available_variant.featured_image != blank -%}
              {%- assign resolved_img = fallback_product.selected_or_first_available_variant.featured_image -%}
              {%- assign resolved_img_src = fallback_product.selected_or_first_available_variant.featured_image | image_url: width: 900 -%}
              {%- assign resolved_img_alt = fallback_product.title | escape -%}
              {%- assign resolved_img_w = fallback_product.selected_or_first_available_variant.featured_image.width -%}
              {%- assign resolved_img_h = fallback_product.selected_or_first_available_variant.featured_image.height -%}
              {%- assign grid_product = fallback_product -%}
            {%- elsif fallback_product != blank and fallback_product.media != empty and fallback_product.media.first.preview_image != blank -%}
              {%- assign resolved_img = fallback_product.media.first.preview_image -%}
              {%- assign resolved_img_src = fallback_product.media.first.preview_image | image_url: width: 900 -%}
              {%- assign resolved_img_alt = fallback_product.title | escape -%}
              {%- assign resolved_img_w = fallback_product.media.first.preview_image.width -%}
              {%- assign resolved_img_h = fallback_product.media.first.preview_image.height -%}
              {%- assign grid_product = fallback_product -%}
            {%- else -%}
              {%- assign resolved_img = nil -%}
            {%- endif -%}
          {%- else -%}
            {%- assign resolved_img = nil -%}
          {%- endif -%}
          {%- assign hover_img = nil -%}
          {%- assign hover_img_src = nil -%}
          {%- if grid_product != blank and resolved_img != nil -%}
            {%- for media in grid_product.media -%}
              {%- if media.preview_image != blank and media.preview_image.id != resolved_img.id -%}
                {%- assign hover_img = media.preview_image -%}
                {%- assign hover_img_src = media.preview_image | image_url: width: 900 -%}
                {%- break -%}
              {%- endif -%}
            {%- endfor -%}
          {%- endif -%}
          <div class="cgg-grid-item" {{ block.shopify_attributes }}>
            {%- if resolved_img != nil -%}
              <img
                class="cgg-grid-img-primary"
                src="{{ resolved_img_src }}"
                alt="{{ resolved_img_alt }}"
                loading="lazy"
                width="{{ resolved_img_w | default: 900 }}"
                height="{{ resolved_img_h | default: 900 }}"
              >
              {%- if hover_img != nil -%}
                <img
                  class="cgg-grid-img-hover"
                  src="{{ hover_img_src }}"
                  alt="{{ resolved_img_alt }}"
                  loading="lazy"
                  width="{{ hover_img.width | default: 900 }}"
                  height="{{ hover_img.height | default: 900 }}"
                >
              {%- endif -%}
            {%- else -%}
              <span class="visually-hidden">No product image available</span>
            {%- endif -%}
            <div
              class="cgg-hotspot"
              style="left:{{ block.settings.hotspot_x }}%;top:{{ block.settings.hotspot_y }}%"
            >
              <button
                class="cgg-hotspot-btn"
                aria-label="View product"
                data-popup="cgg-popup-{{ block.id }}"
              >+</button>
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>

  {%- for block in section.blocks -%}
    {%- if block.type == 'hotspot_image' -%}
      {%- assign product = block.settings.product -%}
      {%- if product == blank and section.settings.fallback_collection != blank -%}
        {%- assign product = section.settings.fallback_collection.products[forloop.index0] -%}
      {%- endif -%}
      {%- assign popup_label = product.title | default: block.settings.hotspot_label | default: 'Product details' -%}
      <div class="cgg-popup-overlay" id="cgg-popup-{{ block.id }}" role="dialog" aria-modal="true" aria-label="{{ popup_label | escape }}" data-product-handle="{{ product.handle | escape }}">
        <div class="cgg-popup">
          <button class="cgg-popup-close" aria-label="Close">&times;</button>

          {%- if product != blank -%}
            {%- assign popup_img_src = nil -%}
            {%- if product.featured_image != blank -%}
              {%- assign popup_img_src = product.featured_image | image_url: width: 240 -%}
              {%- assign popup_img_alt = product.title | escape -%}
            {%- elsif product.selected_or_first_available_variant.featured_image != blank -%}
              {%- assign popup_img_src = product.selected_or_first_available_variant.featured_image | image_url: width: 240 -%}
              {%- assign popup_img_alt = product.title | escape -%}
            {%- elsif product.media != empty and product.media.first.preview_image != blank -%}
              {%- assign popup_img_src = product.media.first.preview_image | image_url: width: 240 -%}
              {%- assign popup_img_alt = product.title | escape -%}
            {%- elsif block.settings.image != blank -%}
              {%- assign popup_img_src = block.settings.image | image_url: width: 240 -%}
              {%- assign popup_img_alt = product.title | escape -%}
            {%- endif -%}
            <div class="cgg-popup-top">
              {%- if popup_img_src != nil -%}
                <img
                  class="cgg-popup-img"
                  src="{{ popup_img_src }}"
                  alt="{{ popup_img_alt }}"
                  width="120"
                  height="120"
                >
              {%- else -%}
                <div class="cgg-popup-img" aria-hidden="true"></div>
              {%- endif -%}
              <div class="cgg-popup-info">
                <p class="cgg-popup-name">{{ product.title }}</p>
                <p class="cgg-popup-price">{{ product.price | money }}</p>
                <p class="cgg-popup-desc">{{ product.description | strip_html | truncate: 110 }}</p>
              </div>
            </div>

            {%- assign color_option = product.options_with_values | where: 'name', 'Color' | first -%}
            {%- assign size_option = product.options_with_values | where: 'name', 'Size' | first -%}

            {%- if color_option -%}
              <p class="cgg-popup-label">{{ color_option.name }}</p>
              <div class="cgg-popup-variants">
                {%- for value in color_option.values -%}
                  <button
                    class="cgg-popup-variant{% if forloop.first %} selected{% endif %}"
                    data-option="color"
                    data-value="{{ value | escape }}"
                  >{{ value }}</button>
                {%- endfor -%}
              </div>
            {%- endif -%}

            {%- if size_option -%}
              <p class="cgg-popup-label">{{ size_option.name }}</p>
              <div class="cgg-popup-select-wrap">
                <select class="cgg-popup-select" data-option="size">
                  <option value="">Choose your size</option>
                  {%- for value in size_option.values -%}
                    <option value="{{ value | escape }}">{{ value }}</option>
                  {%- endfor -%}
                </select>
              </div>
            {%- endif -%}

            <form action="/cart/add" method="post" data-popup-form="{{ block.id }}">
              <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}" data-variant-id>
              <input type="hidden" name="quantity" value="1">
              <button type="submit" class="cgg-popup-atc"{% if size_option or product.selected_or_first_available_variant.available == false %} disabled{% endif %}>
                {%- if product.selected_or_first_available_variant.available -%}ADD TO CART &nbsp;&rarr;{%- else -%}UNAVAILABLE{%- endif -%}
              </button>
            </form>

          {%- else -%}
            <div class="cgg-popup-top">
              <div class="cgg-popup-info">
                <p class="cgg-popup-name">{{ block.settings.hotspot_label }}</p>
                <p class="cgg-popup-desc">Assign a product to this hotspot in the theme editor.</p>
              </div>
            </div>
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}
  {%- endfor -%}

</div>

<script>
(function(){
  'use strict';

  var FOCUSABLE = 'a[href],button:not([disabled]),select,textarea,input,[tabindex]:not([tabindex="-1"])';
  var lastTrigger = null;

  function getFocusable(popup) {
    if (!popup) return [];
    return Array.prototype.slice.call(popup.querySelectorAll(FOCUSABLE));
  }

  function openPopup(overlay, trigger) {
    if (!overlay) return;
    lastTrigger = trigger || null;
    overlay.classList.add('active');
    document.body.style.overflow = 'hidden';
    var popup = overlay.querySelector('.cgg-popup');
    var focusable = getFocusable(popup);
    if (focusable.length) focusable[0].focus();
  }

  function closePopup(overlay) {
    if (!overlay) return;
    overlay.classList.remove('active');
    document.body.style.overflow = '';
    if (lastTrigger) { lastTrigger.focus(); lastTrigger = null; }
  }

  // ── Focus trap ──
  document.addEventListener('keydown', function(e) {
    var active = document.querySelector('.cgg-popup-overlay.active');
    if (!active) return;
    if (e.key === 'Escape') { closePopup(active); return; }
    if (e.key !== 'Tab') return;
    var focusable = getFocusable(active.querySelector('.cgg-popup'));
    if (!focusable.length) return;
    var first = focusable[0], last = focusable[focusable.length - 1];
    if (e.shiftKey) {
      if (document.activeElement === first) { e.preventDefault(); last.focus(); }
    } else {
      if (document.activeElement === last) { e.preventDefault(); first.focus(); }
    }
  });

  // ── Open popup + load variants ──
  document.querySelectorAll('.cgg-hotspot-btn').forEach(function(btn) {
    btn.addEventListener('click', function(e) {
      e.stopPropagation();
      var overlay = document.getElementById(btn.getAttribute('data-popup'));
      if (!overlay) return;
      var popup = overlay.querySelector('.cgg-popup');
      // Propagate handle before loading variants and opening
      if (popup && overlay.dataset.productHandle) {
        popup.dataset.productHandle = overlay.dataset.productHandle;
      }
      if (popup) loadVariants(popup);
      openPopup(overlay, btn);
    });
  });

  // ── Close via X ──
  document.querySelectorAll('.cgg-popup-close').forEach(function(btn) {
    btn.addEventListener('click', function() {
      closePopup(btn.closest('.cgg-popup-overlay'));
    });
  });

  // ── Close via backdrop click ──
  document.querySelectorAll('.cgg-popup-overlay').forEach(function(overlay) {
    overlay.addEventListener('click', function(e) {
      if (e.target === overlay) closePopup(overlay);
    });
  });

  // ── Variant resolution ──
  // Cache: popupId -> { handle, variants }
  var variantCache = {};

  function resolveVariant(popup) {
    var form = popup.querySelector('[data-popup-form]');
    if (!form) return;
    var variantInput = form.querySelector('[data-variant-id]');
    var atcBtn = form.querySelector('.cgg-popup-atc');
    if (!variantInput) return;
    var handle = popup.dataset.productHandle;
    if (!handle) return;
    var colorBtn = popup.querySelector('.cgg-popup-variant.selected');
    var sizeSelect = popup.querySelector('.cgg-popup-select[data-option="size"]');
    var selectedColor = colorBtn ? colorBtn.dataset.value : null;
    var selectedSize = sizeSelect ? sizeSelect.value : null;
    var cached = variantCache[handle];
    if (!cached) return;
    if (sizeSelect && !selectedSize) {
      variantInput.value = '';
      if (atcBtn) { atcBtn.disabled = true; atcBtn.textContent = 'ADD TO CART \u00a0\u2192'; }
      return;
    }
    var match = cached.find(function(v) {
      var colorOk = !selectedColor || v.option1 === selectedColor || v.option2 === selectedColor || v.option3 === selectedColor;
      var sizeOk = !selectedSize || v.option1 === selectedSize || v.option2 === selectedSize || v.option3 === selectedSize;
      return colorOk && sizeOk;
    });
    if (match) {
      variantInput.value = match.id;
      if (atcBtn) {
        atcBtn.disabled = !match.available;
        atcBtn.textContent = match.available ? 'ADD TO CART \u00a0\u2192' : 'UNAVAILABLE';
      }
    } else {
      variantInput.value = '';
      if (atcBtn) { atcBtn.disabled = true; atcBtn.textContent = 'UNAVAILABLE'; }
    }
  }

  function loadVariants(popup) {
    var handle = popup.dataset.productHandle;
    if (!handle) return;
    if (variantCache[handle]) { resolveVariant(popup); return; }
    fetch('/products/' + handle + '.js')
      .then(function(r) { if (!r.ok) throw new Error(r.status); return r.json(); })
      .then(function(data) {
        variantCache[handle] = data.variants || [];
        resolveVariant(popup);
      })
      .catch(function() {});
  }

  // Propagate product handle from overlay to inner popup element (init)
  document.querySelectorAll('.cgg-popup-overlay').forEach(function(overlay) {
    var popup = overlay.querySelector('.cgg-popup');
    if (popup && overlay.dataset.productHandle) {
      popup.dataset.productHandle = overlay.dataset.productHandle;
    }
  });

  // ── Color variant selection ──
  document.querySelectorAll('.cgg-popup-variant').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var group = btn.closest('.cgg-popup-variants');
      if (!group) return;
      group.querySelectorAll('.cgg-popup-variant').forEach(function(b) { b.classList.remove('selected'); });
      btn.classList.add('selected');
      var popup = btn.closest('.cgg-popup');
      if (popup) resolveVariant(popup);
    });
  });

  // ── Size selection ──
  document.querySelectorAll('.cgg-popup-select[data-option="size"]').forEach(function(sel) {
    sel.addEventListener('change', function() {
      var popup = sel.closest('.cgg-popup');
      if (popup) resolveVariant(popup);
    });
  });

  // ── AJAX Add to Cart ──
  document.querySelectorAll('[data-popup-form]').forEach(function(form) {
    form.addEventListener('submit', function(e) {
      e.preventDefault();
      var variantInput = form.querySelector('[data-variant-id]');
      if (!variantInput || !variantInput.value) return;
      var atcBtn = form.querySelector('.cgg-popup-atc');
      if (!atcBtn) return;
      var orig = atcBtn.innerHTML;
      atcBtn.innerHTML = 'ADDING...';
      atcBtn.disabled = true;
      fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
        body: JSON.stringify({ id: parseInt(variantInput.value, 10), quantity: 1 })
      })
      .then(function(r) { if (!r.ok) throw new Error(r.status); return r.json(); })
      .then(function(data) {
        if (data && data.id) {
          atcBtn.innerHTML = 'ADDED \u2713';
          document.dispatchEvent(new CustomEvent('cart:refresh'));
          document.dispatchEvent(new CustomEvent('cart:updated'));
        } else {
          throw new Error('no_id');
        }
        setTimeout(function() { atcBtn.innerHTML = orig; atcBtn.disabled = false; }, 2000);
      })
      .catch(function() {
        atcBtn.innerHTML = 'TRY AGAIN';
        setTimeout(function() { atcBtn.innerHTML = orig; atcBtn.disabled = false; }, 2000);
      });
    });
  });

})();
</script>

