{%- style -%}
/* ── WRAPPER ── */
.cgg-wrap {
  display: block;
  width: 100%;
  font-family: 'Poppins', sans-serif;
  color: #000;
  -webkit-font-smoothing: antialiased;
}
.cgg-wrap *, .cgg-wrap *::before, .cgg-wrap *::after {
  box-sizing: border-box;
}

/* ── NAV ── */
.cgg-nav {
  display: grid;
  grid-template-columns: auto 1fr auto;
  align-items: center;
  gap: 24px;
  width: 100%;
  height: 72px;
  background: #f2f2f2;
  padding: 0 56px;
  margin: 0;
}
.cgg-logo {
  font-family: 'Poppins', sans-serif;
  font-size: 13px;
  font-weight: 700;
  letter-spacing: 0.3em;
  text-transform: uppercase;
  color: #000;
  white-space: nowrap;
  line-height: 1;
}
.cgg-tagline {
  font-family: 'Poppins', sans-serif;
  font-size: 14px;
  font-weight: 400;
  text-align: center;
  color: #000;
  line-height: 1.4;
}
.cgg-nav-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 220px;
  height: 52px;
  background: #ece21c;
  color: #000;
  font-family: 'Poppins', sans-serif;
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  text-decoration: none;
  white-space: nowrap;
  flex-shrink: 0;
  border: none;
  cursor: pointer;
  transition: background 0.15s;
}
.cgg-nav-btn:hover { background: #d4cc00; color: #000; text-decoration: none; }

/* ── HERO ── */
.cgg-hero {
  position: relative;
  width: 100%;
  height: calc(100vh - 72px);
  min-height: 560px;
  overflow: hidden;
  background: #fff;
}

/* ── BACKGROUND — rendered as CSS background to avoid SVG crop issues ── */
.cgg-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 42px;
  z-index: 0;
  background-color: #fff;
  background-repeat: no-repeat;
  background-size: cover;
  background-position: center top;
}
/* When a Liquid image is used, we render an <img> inside */
.cgg-bg img {
  display: block !important;
  width: 100% !important;
  height: 100% !important;
  max-width: none !important;
  object-fit: cover !important;
  object-position: center top !important;
}

/* ── CARD — white backing so text is always readable ── */
.cgg-card {
  position: absolute;
  left: 40px;
  bottom: 62px;
  z-index: 10;
  width: 420px;
  display: flex;
  flex-direction: column;
  gap: 18px;
  background: rgba(255,255,255,0.0);
}

/* Title */
.cgg-card-title {
  font-family: 'Playfair Display', serif !important;
  font-size: 64px !important;
  font-weight: 700 !important;
  line-height: 1.0 !important;
  color: #000 !important;
  letter-spacing: -0.02em !important;
  margin: 0 !important;
  padding: 0 !important;
  display: block !important;
  text-transform: none !important;
}

/* Description */
.cgg-card-desc {
  font-family: 'Poppins', sans-serif !important;
  font-size: 14px !important;
  line-height: 1.7 !important;
  color: #000 !important;
  max-width: 360px !important;
  margin: 0 !important;
  padding: 0 !important;
  display: block !important;
  font-weight: 400 !important;
}

/* CTA Button */
.cgg-card-btn {
  display: inline-flex !important;
  align-items: center !important;
  justify-content: center !important;
  height: 52px !important;
  padding: 0 32px !important;
  background: #000 !important;
  color: #fff !important;
  font-family: 'Poppins', sans-serif !important;
  font-size: 11px !important;
  font-weight: 700 !important;
  letter-spacing: 0.22em !important;
  text-transform: uppercase !important;
  text-decoration: none !important;
  border: none !important;
  border-radius: 3px !important;
  cursor: pointer !important;
  box-shadow: none !important;
  width: fit-content !important;
  transition: background 0.15s !important;
}
.cgg-card-btn:hover { background: #222 !important; color: #fff !important; text-decoration: none !important; }

/* ── STRIP ── */
.cgg-strip {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 42px;
  background: #e8e8e8;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 20;
  padding: 0 24px;
}
.cgg-strip-text {
  font-family: 'Poppins', sans-serif;
  font-size: 11px;
  font-weight: 600;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: #000;
  text-align: center;
  line-height: 1;
}

/* ── TABLET ── */
@media (max-width: 1024px) {
  .cgg-nav { padding: 0 32px; gap: 16px; }
  .cgg-card { left: 32px; width: min(380px, calc(100% - 64px)); }
  .cgg-card-title { font-size: clamp(44px, 6vw, 64px) !important; }
}

/* ── MOBILE ── */
@media (max-width: 680px) {
  .cgg-nav {
    grid-template-columns: 1fr;
    height: auto;
    padding: 14px 20px;
    gap: 10px;
    text-align: center;
    justify-items: center;
  }
  .cgg-hero {
    height: auto;
    min-height: 100svh;
    padding-bottom: 42px;
  }
  .cgg-bg { bottom: 42px; }
  .cgg-card {
    position: relative;
    left: auto;
    bottom: auto;
    width: calc(100% - 32px);
    margin: 20px auto 0;
    gap: 14px;
    background: rgba(255,255,255,0.88);
    padding: 20px;
    border-radius: 8px;
  }
  .cgg-card-title { font-size: clamp(36px, 10vw, 56px) !important; }
  .cgg-card-desc { font-size: 13px !important; max-width: 100% !important; }
  .cgg-card-btn { width: 100% !important; padding: 0 !important; }
  .cgg-strip { position: relative; }
}
{%- endstyle -%}

<div class="cgg-wrap">

  <nav class="cgg-nav" aria-label="Gift guide navigation">
    <span class="cgg-logo">{{ section.settings.logo_text }}</span>
    <span class="cgg-tagline">{{ section.settings.header_tagline }}</span>
    <a class="cgg-nav-btn" href="{{ section.settings.header_cta_link | default: '#' }}">
      {{- section.settings.header_cta_label -}}&nbsp;&nbsp;→
    </a>
  </nav>

  <div class="cgg-hero">

    {%- comment -%}
      Background: use inline style with asset_url so the SVG scales as a CSS
      background-image — avoids the object-fit crop that was showing the wrong
      part of the illustration.
    {%- endcomment -%}
    {%- if section.settings.bg_image != blank -%}
      {%- assign bg_src = section.settings.bg_image | image_url: width: 2400 -%}
    {%- else -%}
      {%- assign bg_src = 'gift-guide-banner.svg' | asset_url -%}
    {%- endif -%}
    <div
      class="cgg-bg"
      aria-hidden="true"
      style="background-image: url('{{ bg_src }}');"
    ></div>

    <div class="cgg-card">
      <span class="cgg-card-title">{{ section.settings.card_title }}</span>
      <span class="cgg-card-desc">{{ section.settings.card_desc | newline_to_br }}</span>
      <a class="cgg-card-btn" href="{{ section.settings.card_cta_link | default: '#' }}">
        {{- section.settings.card_cta_label -}}&nbsp;&nbsp;→
      </a>
    </div>

    <div class="cgg-strip">
      <span class="cgg-strip-text">{{ section.settings.strip_text }}</span>
    </div>

  </div>

</div>

{% schema %}
{
  "name": "Custom Gift Guide",
  "settings": [
    { "type": "text",         "id": "logo_text",        "label": "Logo",             "default": "TISSO VISON" },
    { "type": "text",         "id": "header_tagline",   "label": "Header tagline",   "default": "Find the ideal gift for your loved ones." },
    { "type": "text",         "id": "header_cta_label", "label": "Header CTA label", "default": "CHOOSE GIFT" },
    { "type": "url",          "id": "header_cta_link",  "label": "Header CTA link" },
    { "type": "image_picker", "id": "bg_image",         "label": "Hero background (leave blank for default SVG)" },
    { "type": "text",         "id": "card_title",       "label": "Card title",       "default": "The Gift Guide" },
    { "type": "textarea",     "id": "card_desc",        "label": "Card description", "default": "Discover Joy: Your Ultimate Holiday Gift Destination.\nExplore our curated selection and find the perfect gifts to delight your loved ones this holiday season." },
    { "type": "text",         "id": "card_cta_label",   "label": "Card CTA label",   "default": "SHOP NOW" },
    { "type": "url",          "id": "card_cta_link",    "label": "Card CTA link" },
    { "type": "text",         "id": "strip_text",       "label": "Bottom strip text","default": "SUSTAINABLE, ETHICALLY MADE CLOTHES IN SIZES XXS TO 6XL" }
  ],
  "presets": [{ "name": "Custom Gift Guide" }]
}
{% endschema %}
